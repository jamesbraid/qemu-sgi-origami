config SGI_ROUTER
    bool
    select ONEWIRE
    # SGI_NET_CABLE selects SGI_NET_PORT in turn: the Router calls into both
    # unconditionally (a cable joins its ports to their peers), so either one
    # missing is a link failure, not a disabled feature.
    select SGI_NET_CABLE

