# See docs/devel/tracing.rst for syntax documentation.

# mcf5206e-mbus.c
mcf5206e_mbus_start(bool repeated) "repeated %d"
mcf5206e_mbus_byte(bool tx, uint8_t byte, bool nack) "tx %d byte 0x%02x nack %d"
mcf5206e_mbus_stop(void) ""
mcf5206e_mbus_lost(void) ""

# sgi-l1-board-peers.c
sgi_l1_expander_write(uint8_t wire, uint8_t segment, uint8_t value) "wire 0x%02x segment %u write 0x%02x"
sgi_l1_expander_read(uint8_t wire, uint8_t segment, uint8_t value) "wire 0x%02x segment %u read 0x%02x"
sgi_l1_monitor_write(uint8_t wire, uint8_t segment, uint8_t reg, uint8_t value) "wire 0x%02x segment %u register 0x%02x write 0x%02x"
sgi_l1_monitor_read(uint8_t wire, uint8_t segment, uint8_t reg, uint8_t value) "wire 0x%02x segment %u register 0x%02x read 0x%02x"
sgi_l1_display_write(uint8_t value) "write 0x%02x"
sgi_l1_signal_decode(const char *line, bool level, uint8_t fan, uint8_t bedrock1, uint8_t bedrock2) "line %s level %d (fan 0x%02x bedrock1 0x%02x bedrock2 0x%02x)"
sgi_l1_usb_read(uint64_t offset, uint8_t value) "offset 0x%" PRIx64 " read 0x%02x"
sgi_l1_usb_write(uint64_t offset, uint8_t value) "offset 0x%" PRIx64 " write 0x%02x"
