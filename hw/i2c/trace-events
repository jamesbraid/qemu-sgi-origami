smbus_transaction(uint8_t addr, uint8_t prot) "addr=0x%02x prot=0x%02x"

# allwinner_i2c.c

allwinner_i2c_read(const char* reg_name, uint64_t offset, uint64_t value) "read %s [0x%" PRIx64 "]: -> 0x%" PRIx64
