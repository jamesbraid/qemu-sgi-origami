pcf8584_data_read(uint32_t master, int cpu, uint8_t value, uint8_t grant, uint8_t status, uint8_t phase, int active, int busy, uint32_t owner, uint64_t contenders) "master:%" PRIu32 " cpu:%d value:0x%02x grant:0x%02x status:0x%02x phase:%u active:%d busy:%d owner:%" PRIu32 " contenders:0x%" PRIx64
pcf8584_send(uint32_t master, uint8_t value, int success) "master:%" PRIu32 " send byte: 0x%02x, success: %d"
pcf8584_recv(uint32_t master, uint8_t value) "master:%" PRIu32 " recv byte: 0x%02x"
pcf8584_nack(uint32_t master) "master:%" PRIu32 " nacking"
pcf8584_stop(uint32_t master) "master:%" PRIu32 " stopping"
pcf8584_stop_deferred(uint32_t master, uint8_t phase) "master:%" PRIu32 " STOP written in wire phase %u, placed after the byte"
