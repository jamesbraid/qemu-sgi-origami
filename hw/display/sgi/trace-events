# Shared events, named by role. A family's own events (sgi_mgras_dma_chunk
# and the rest) stay in the family's directory, where its tools parse them.

# board-memory.c
sgi_plane_add(uint32_t id, uint64_t base, uint64_t len, uint32_t width, uint32_t height, uint32_t stride, int format) "plane %u base 0x%" PRIx64 " len 0x%" PRIx64 " %ux%u stride %u format %d"

# pixel-dma.c
sgi_dma_map(uint64_t seq, int dir, uint64_t offset, uint64_t len, unsigned chunks) "seq %" PRIu64 " dir %d offset 0x%" PRIx64 " len 0x%" PRIx64 " chunks %u"
sgi_dma_bounce(uint64_t addr, unsigned len) "addr 0x%" PRIx64 " len %u"
sgi_dma_pixels(uint64_t seq, int dir, uint32_t plane, int x, int y, int w, int h, int status) "seq %" PRIu64 " dir %d plane %u at %d,%d size %dx%d status %d"

# command-fetch.c
sgi_fetch(uint64_t seq, uint32_t context, unsigned segments, uint64_t words, int status) "seq %" PRIu64 " context %u segments %u words %" PRIu64 " status %d"

# scanout.c
sgi_scanout_mode(uint32_t width, uint32_t height, uint64_t frame_clocks, uint32_t clock_hz) "%ux%u frame %" PRIu64 " clocks at %u Hz"
sgi_scanout_retrace(uint64_t frame, uint32_t swaps) "frame %" PRIu64 " swaps waiting %u"
sgi_scanout_swap(uint64_t seq, uint64_t cookie, uint64_t frame) "seq %" PRIu64 " cookie 0x%" PRIx64 " frame %" PRIu64
sgi_scanout_update(unsigned first, unsigned last) "lines %u-%u"
