mips_ss = ss.source_set()
mips_ss.add(files('bootloader.c', 'mips_int.c'))
common_ss.add(when: 'CONFIG_FW_CFG_MIPS', if_true: files('fw_cfg.c'))
common_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_bootp.c'))
mips_ss.add(when: 'CONFIG_LOONGSON3V', if_true: files('loongson3_virt.c'))
mips_ss.add(when: 'CONFIG_MALTA', if_true: files('malta.c'))
mips_ss.add(when: 'CONFIG_MIPS_CPS', if_true: files('cps.c'))

if 'CONFIG_TCG' in config_all_accel
mips_ss.add(when: 'CONFIG_JAZZ', if_true: files('jazz.c'))
# These generated model inputs are tracked sources, committed rather than
# regenerated by the build during configure.
mips_ss.add(when: 'CONFIG_SGI_OCTANE', if_true: files('sgi/octane.c'))
mips_ss.add(when: 'CONFIG_SGI_OCTANE', if_true: files('../block/lh28f800su.c'))
mips_ss.add(when: ['CONFIG_SGI_OCTANE', 'CONFIG_TEST_DEVICES'],
            if_true: files('../../tests/qtest/lh28f800su-fixture.c'))
mips_ss.add(when: 'CONFIG_SGI_SN0', if_true: files('sgi/sn0.c'))
# These qtest-only fixtures live under tests/qtest, beside the qtest
# programs that are their only consumer, and are pulled in here because
# meson builds hw/ before tests/ so the target binary must gain them here.
mips_ss.add(when: ['CONFIG_SGI_SN0', 'CONFIG_TEST_DEVICES'],
            if_true: files('../../tests/qtest/sn0-origin2000-flash-fixture.c',
                           '../../tests/qtest/sn-builder-fault-test.c'))
# Shared by sgi-sn0-node and sgi-sn1-node; SGI_SN0 always implies SGI_SN1 is
# also selected on this fork's mips64 target, so either config would do.
mips_ss.add(when: 'CONFIG_SGI_SN0', if_true: files('sgi/sn-promdata.c'))
# The family machine base and builder over the compiled catalogue
# (qapi/sgi-sn.json, embedded and parsed by sgi/sn-catalogue.c below).
mips_ss.add(when: 'CONFIG_SGI_SN0', if_true: files('sgi/sn-machine.c'))
mips_ss.add(when: 'CONFIG_SGI_SN1',
            if_true: files('sgi/sn1.c', 'sgi/sn1-node.c',
                           'sgi/sn1-topology.c'))
# The XIO port interface and the two link kinds that connect it:
# shared by whichever machines build XIO boards or links, so each
# selects on its own Kconfig symbol rather than either machine's.
mips_ss.add(when: 'CONFIG_SGI_XIO_PORT',
            if_true: files('sgi/xio-port.c', 'sgi/xio-widget.c'))
mips_ss.add(when: 'CONFIG_SGI_XIO_LINK', if_true: files('sgi/xio-link.c'))
# The network port interface and the cable that joins two of them: shared
# by the Hub and the Router, so each selects on its own Kconfig symbol
# rather than either device's.
mips_ss.add(when: 'CONFIG_SGI_NET_PORT', if_true: files('sgi/net-port.c'))
# Graphics flow control in the processor interface: shared by the Hub and
# the Bedrock, so each selects it.
mips_ss.add(when: 'CONFIG_SGI_PI_GFX',
            if_true: files('sgi/pi-gfx.c', 'sgi/pi-gfx-state.c'))
mips_ss.add(when: 'CONFIG_SGI_NET_CABLE', if_true: files('sgi/net-cable.c'))
# The XIO board base class: the removable card that plugs into an XIO slot.
# Shared by every XIO card, so it selects on its own Kconfig symbol rather
# than either machine's.
mips_ss.add(when: 'CONFIG_SGI_XIO_BOARD', if_true: files('sgi/xio-board.c'))
# Likewise for the XIO board fixture: see the comment above.
mips_ss.add(when: 'CONFIG_SGI_XIO_BOARD_TEST',
            if_true: files('../../tests/qtest/xio-test-board.c'))
# sgi-baseio: the base I/O functional unit as one device with a preset per
# shipped board design. Every product that carries base I/O selects this, whether or
# not it also builds an XIO card: the IP29 and IO-8 presets have no card of
# their own, only a carrier that owns the chip directly.
mips_ss.add(when: 'CONFIG_SGI_BASEIO', if_true: files('sgi/baseio.c'))
# The BASEIO PROM flash part, fitted by the BaseIO XIO card and by the
# GIGAchannel cabinet.
mips_ss.add(when: 'CONFIG_SGI_BASEIO_FLASH',
            if_true: files('sgi/baseio-flash.c'))
# The Origin 2000/Onyx2 BaseIO XIO card: an sgi-xio-board subclass that
# creates its own Bridge and an sgi-baseio (the "baseio" preset) behind it.
mips_ss.add(when: 'CONFIG_SGI_XIO_BASEIO', if_true: files('sgi/xio-baseio.c'))
mips_ss.add(when: 'CONFIG_SGI_PCI_EXPANSION',
            if_true: files('sgi/board-pci-expansion.c'))
# The Origin 200 GIGAchannel expansion cabinet's own I/O: the Bridge its
# Crossbow reaches on link 8, and the cabinet's system-controller status
# word on that Bridge's external-flash port.
mips_ss.add(when: 'CONFIG_SGI_GIGACHANNEL',
            if_true: files('sgi/board-gigachannel.c'))
# The SGI PCI-XTALK ADAPTER (the "PCI shoehorn"), a single-XIO-slot
# sgi-xio-board subclass that creates its own Bridge and can fit an SGI Cad
# Duo input card behind it with its keyboard/mouse interrupt wired.
mips_ss.add(when: 'CONFIG_SGI_PCI_SHOEHORN',
            if_true: files('sgi/board-pci-shoehorn.c'))
# Likewise for the board fixture: see the comment above.
mips_ss.add(when: 'CONFIG_SGI_BOARD_TEST',
            if_true: files('../../tests/qtest/board-test-fixture.c',
                           '../../tests/qtest/ioc3-release-fixture.c'))
subdir('sgi')
mips_ss.add(when: 'CONFIG_FULOONG', if_true: files('fuloong2e.c'))
mips_ss.add(when: 'CONFIG_MIPS_BOSTON', if_true: files('boston.c'))
endif

hw_arch += {'mips': mips_ss}
