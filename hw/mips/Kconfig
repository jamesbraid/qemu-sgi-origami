    select SGI_HUB
    select SGI_IP29_IO
    select SGI_O2000_MODULE_MGMT
    select SGI_IOC3
    select SGI_IOC3_ETH
    select SGI_PCI_EXPANSION
    select SGI_ROUTER
    select SGI_XBOW
    select TIGON

config SGI_SN1
    bool
    default y
    depends on MIPS64 && TARGET_BIG_ENDIAN
    imply TEST_DEVICES
    select QLOGIC_ISP_SCSI_PCI
    select SGI_BEDROCK
    select SGI_BEDROCK_FLASH
