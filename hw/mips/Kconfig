    bool
    select SGI_XIO_PORT

config SGI_NET_PORT
    bool

# Graphics flow control in the processor interface: shared by the Hub and
# the Bedrock, so each selects it.
config SGI_PI_GFX
    bool

config SGI_CRIME
    bool
    default y if SGI_DEVICES
    depends on SGI_DEVICES

config SGI_MACE
    bool
    default y if SGI_DEVICES
    depends on SGI_DEVICES
    select DS1685
    select ICS1890
    select ONEWIRE
    select PCI
    select SERIAL_MM

config SGI_NET_CABLE
    bool
    select SGI_NET_PORT

config SGI_XIO_BOARD
    bool
    select SGI_BRIDGE
    select SGI_XBOW
    select SGI_XIO_LINK

# Every qtest-only SGI device and board fixture, built into the emulator
# only for test builds. Each is compiled from tests/qtest/ or
# tests/qtest/fixtures/ by the meson file of the subsystem it plugs into,
# which adds the model it needs through the selects below.
config SGI_TEST_FIXTURES
    bool
    default y
    depends on TEST_DEVICES && SGI_DEVICES
    select SGI_BASEIO
    select SGI_BEDROCK_IO
    select SGI_BRIDGE
    select SGI_COMMAND_PORT
    select SGI_HUB if SGI_SN0
    select SGI_PCI_EXPANSION
    select SGI_PIC
    select SGI_PI_GFX
    select SGI_ROUTER if SGI_SN0
    select SGI_XBOW
    select SGI_XBRIDGE
    select SGI_XIO_BASEIO
    select SGI_XIO_BOARD
    select SGI_XIO_PORT

# sgi-baseio (the base I/O functional unit, presets ip29/baseio/io8) is
# selected directly by whichever family builds base I/O at all: Origin
# 200's onboard I/O and Origin 300's IO-8 have no XIO card of their own,
# only a carrier (sn0.c, sn1-node.c) that owns the Bridge or XBridge chip
# directly and hands sgi-baseio its PCI bus. SGI_XIO_BASEIO is the Origin
# 2000/Onyx2 BaseIO card, the one preset with a removable-card carrier.
config SGI_BASEIO
    bool
    select QLOGIC_ISP_SCSI_PCI
    select SGI_IOC3
    select USB_OHCI_PCI

# The BASEIO PROM flash part a Bridge's external-flash port carries on
# the Origin 2000 BaseIO card and in the Origin 200 GIGAchannel cabinet.
config SGI_BASEIO_FLASH
    bool
    select PFLASH_CFI02
    select SGI_PROM_IMAGE

config SGI_XIO_BASEIO
    bool
    select SGI_XIO_BOARD
    select SGI_BRIDGE
    select SGI_BASEIO
    select SGI_BASEIO_FLASH

config SGI_PCI_EXPANSION
    bool
    select SGI_XIO_BOARD
    select SGI_BRIDGE

config SGI_GIGACHANNEL
    bool
    select SGI_XIO_BOARD
    select SGI_BRIDGE
    select SGI_BASEIO_FLASH

config SGI_PCI_SHOEHORN
    bool
    select SGI_XIO_BOARD
    select SGI_BRIDGE
    select SGI_IOC3
    select SGI_IOC3_ETH

config FULOONG
    bool
    default y
    depends on MIPS64 && !TARGET_BIG_ENDIAN
    imply PCI_DEVICES
    imply TEST_DEVICES
    imply ATI_VGA
    imply RTL8139_PCI
    select PCI_BONITO
    select SMBUS_EEPROM
    select VT82C686

config LOONGSON3V
    bool
    default y
    depends on MIPS64 && !TARGET_BIG_ENDIAN
    imply PCI_DEVICES
    imply TEST_DEVICES
    imply VIRTIO_PCI
    imply VIRTIO_NET
    imply VIRTIO_VGA
    imply QXL if SPICE
    imply USB_OHCI_PCI
    select SERIAL_MM
    select GOLDFISH_RTC
    select LOONGSON_IPI
    select LOONGSON_LIOINTC
    select PCI_EXPRESS_GENERIC_BRIDGE
    select MSI_NONBROKEN
    select FW_CFG_MIPS
    select UNIMP

config MIPS_CPS
    bool
    select MIPS_ITU if TCG

config MIPS_BOSTON
    bool
    default y
    depends on MIPS64 && !TARGET_BIG_ENDIAN && FDT
    imply PCI_DEVICES
    imply TEST_DEVICES
    select DEVICE_TREE
    select FITLOADER
    select MIPS_CPS
    select PCI_EXPRESS_XILINX
    select AHCI_ICH9
    select SERIAL_MM

config FW_CFG_MIPS
    bool
