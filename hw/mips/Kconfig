    bool
    default y
    depends on MIPS64
    select ISA_BUS
    select RC4030
    select I8259
    select I8254
    select I8257
    select PCSPK
    select VGA_MMIO
    select G364FB
    select DP8393X
    select ESP
    select FDC_SYSBUS
    select MC146818RTC
    select PCKBD
    select SERIAL_MM
    select PARALLEL
    select DS1225Y
    select JAZZ_LED

# The parts this fork models. They are built for the target that runs
# them and for no other: nothing outside a big-endian 64-bit MIPS guest
# has an SGI machine to put them on, and their tests all run there.
config SGI_DEVICES
    bool
    default y
    depends on MIPS64 && TARGET_BIG_ENDIAN

config SGI_CATALOGUE
    bool

config SGI_PROM_IMAGE
    bool

config SGI_O2_ROM
    bool
    default y
    depends on MIPS64 && TARGET_BIG_ENDIAN

config SGI_O2_TEST
    bool
    default y
    depends on SGI_DEVICES
    imply TEST_DEVICES
    select SGI_CRIME
    select AIC7880_SCSI_PCI
    select SGI_MACE
    select SGI_O2_GBE
    select SGI_O2_ROM

config SGI_OCTANE
    bool
    select PFLASH_CFI01
    select SGI_CATALOGUE
    select SGI_PROM_IMAGE
    default y
    depends on MIPS64 && TARGET_BIG_ENDIAN
    select QLOGIC_ISP_SCSI_PCI
    select SGI_RAD1_AUDIO
    select SGI_MGRAS
    select SGI_ODYSSEY
    select SGI_BRIDGE
    select SGI_IOC3
    select SGI_XBOW
    select SGI_XIO_PORT

