o2_at29_poll(uint32_t offset, unsigned int size, int phase, uint32_t sector, unsigned int loaded, uint64_t reads, int64_t now_ns, int64_t deadline_ns, bool toggle, const char *outcome) "offset 0x%" PRIx32 " size %u phase %d sector 0x%" PRIx32 " loaded %u reads %" PRIu64 " virtual_ns %" PRId64 " deadline_ns %" PRId64 " toggle %d outcome %s"

