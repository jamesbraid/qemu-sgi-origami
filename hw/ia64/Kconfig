config SGI_SHUB
    bool
    select SERIAL
    select PFLASH_CFI02
    select SGI_PIC
    select SGI_XIO_LINK
    select SGI_XBOW
    select SGI_DMA_PLACEMENT

config ALTIX350
    bool
    imply TEST_DEVICES
    select SGI_SHUB

# The PCI bus-master fixture, built into the emulator for test builds only.
config ALTIX350_TEST_FIXTURES
    bool
    default y
    depends on TEST_DEVICES && ALTIX350
