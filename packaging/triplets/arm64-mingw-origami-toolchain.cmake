# SPDX-License-Identifier: BSD-3-Clause
# vcpkg's scripts/toolchains/mingw.cmake for arm64, with the compilers taken
# from PATH as Clang instead of as aarch64-w64-mingw32-gcc.
set(CMAKE_SYSTEM_NAME Windows CACHE STRING "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR aarch64 CACHE STRING "")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(CMAKE_CROSSCOMPILING OFF CACHE BOOL "")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    VCPKG_CRT_LINKAGE VCPKG_TARGET_ARCHITECTURE VCPKG_C_FLAGS VCPKG_CXX_FLAGS
    VCPKG_C_FLAGS_RELEASE VCPKG_CXX_FLAGS_RELEASE
    VCPKG_LINKER_FLAGS VCPKG_LINKER_FLAGS_RELEASE)
foreach(lang C CXX)
    set(CMAKE_${lang}_COMPILER_TARGET "aarch64-w64-windows-gnu" CACHE STRING "")
endforeach()
find_program(CMAKE_C_COMPILER NAMES aarch64-w64-mingw32-clang clang REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES aarch64-w64-mingw32-clang++ clang++ REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-windres windres REQUIRED)
string(APPEND CMAKE_C_FLAGS_INIT " ${VCPKG_C_FLAGS} ")
string(APPEND CMAKE_CXX_FLAGS_INIT " ${VCPKG_CXX_FLAGS} ")
string(APPEND CMAKE_C_FLAGS_RELEASE_INIT " ${VCPKG_C_FLAGS_RELEASE} ")
string(APPEND CMAKE_CXX_FLAGS_RELEASE_INIT " ${VCPKG_CXX_FLAGS_RELEASE} ")
foreach(kind MODULE SHARED EXE)
    string(APPEND CMAKE_${kind}_LINKER_FLAGS_INIT " ${VCPKG_LINKER_FLAGS} ")
    string(APPEND CMAKE_${kind}_LINKER_FLAGS_RELEASE_INIT " ${VCPKG_LINKER_FLAGS_RELEASE} ")
endforeach()
