##
# @SGIModelOffering:
#
# One accepted configuration a launcher may select: a product, a
# topology and one of its accepted CPU populations, with every fact a
# launcher needs to build the QEMU command line for it.  Unlike a
# `topologies` record, an offering is not limited to what a machine
# description owns:
# it is the catalogue's launcher-facing half, and carries what a
# launcher may choose rather than only what QEMU's own builder needs.
#
# @product: `-M` value this offering is for
#
# @topology: `topology=` value this offering is for
#
# @default-topology: the topology @product builds with no `topology=`,
#     when one exists; absence means the launcher must require an
#     explicit topology selection.
#
# @display-name: human-readable name of this configuration
#
# @nodes: node count of this configuration
#
# @machine-options: the `-M` value that selects exactly this
#     configuration's product, topology and node count
#
# @cpus-per-node: this offering's accepted population, per node
#
# @dimms-per-node: this offering's fitted DIMM count, per node
#
# @smp: total processor count (`-smp` value)
#
# @memory-per-node-mib: accepted per-node memory sizes
#
# @processor: the processor this population is built from
#
# @firmware: firmware required by this offering
#
# @init-inputs: the images creating this configuration's @storage
#     reads
#
# @storage: every writable persistent store this configuration has
#
# @resources: identity inputs this offering accepts beyond @storage
#
# @scsi-adapters: SCSI host adapters this offering's I/O boards carry
#
# @consoles: serial lines this offering's launch places, in order
#
# @networks: network adapters this offering's I/O boards carry
#
# @console: which of @consoles is the primary console
#
# @launch-recipe: selected board-specific launch preparation, if any
#
# @prom-dialogue: which PROM console dialogue this product speaks
#
# @disk-bus: default disk bus a launcher attaches a boot disk to
#
# @netboot-adapter: adapter kind a netboot launch uses: the @kind of
#     the @networks entry whose @default is true, or unsupported where
#     netboot is not offered
#
# @identity-inputs: named identity/SPD inputs this offering accepts
#
# @hardware-inputs: product-specific launch inputs the configuration
#     binds, and whether each is required.  Overrides of the
#     catalogue's own values are in @overrides
#
# @overrides: every identity or board value the catalogue gives this
#     configuration that a launch may override, and where
#
# @smdk: selected diagnostic launch recipe, when supported
#
# @supported-guests: guest operating systems documented to run on this
#     offering
#
# @install-media: install media kinds this offering supports
#
# @default-cpu-model: default `-cpu` value for this offering
#
# @synthesized-firmware-toggle: whether this product's PROM accepts a
#     debug toggle for a synthesized (non-stock) firmware image
#
# @needs-debug-leds-off: whether this product's PROM dialogue needs
#     its debug LEDs disabled before booting a guest
#
# Since: 11.2
##
{ 'struct': 'SGIModelOffering',
  'data': { 'product': 'str',
            'topology': 'str',
            '*default-topology': 'str',
            'display-name': 'str',
            'nodes': 'uint32',
            'machine-options': 'str',
            'cpus-per-node': ['uint32'],
            'dimms-per-node': ['uint32'],
            'smp': 'uint32',
            'memory-per-node-mib': 'SGIModelMemoryPopulation',
            'processor': 'SGIModelOfferingProcessor',
            '*firmware': 'SGIModelFirmware',
            'init-inputs': ['SGIModelInitInput'],
            'storage': ['SGIModelStorageItem'],
            'resources': ['SGIModelResource'],
            'scsi-adapters': ['SGIModelScsiAdapter'],
            'consoles': ['SGIModelConsole'],
            'networks': ['SGIModelNetworkOffering'],
            'console': 'str',
            '*launch-recipe': 'SGIModelLaunchRecipe',
            'prom-dialogue': 'str',
            'disk-bus': 'str',
            'netboot-adapter': 'str',
            'identity-inputs': ['str'],
            'hardware-inputs': ['SGIModelInputBinding'],
            'overrides': ['SGIModelOverride'],
            '*smdk': 'SGIModelSmdkRecipe',
            'supported-guests': ['str'],
            'install-media': ['str'],
            'default-cpu-model': 'str',
            'synthesized-firmware-toggle': 'bool',
            'needs-debug-leds-off': 'bool' } }

##
# @SGIMachines:
#
# The compiled machine catalogue: every SGI machine configuration this
# emulator can construct, and every configuration a launcher may
# select.  The same document, embedded at build time,
# backs @query-sgi-machines, the running emulator's own copy for a
# package build to read, and external launch tooling.
#
# @schema: catalogue schema name (`sgi-machines`)
#
# @version: catalogue schema version
#
# @topologies: every configuration the builder can construct
#
# @offerings: every configuration a launcher may select
#
# @references: documented configurations retained for comparison
#     They are not buildable or selectable.
#
# Since: 11.2
##
{ 'struct': 'SGIMachines',
  'data': { 'schema': 'str',
            'version': 'uint32',
            'topologies': ['SGIModelTopology'],
            'offerings': ['SGIModelOffering'],
            '*references': ['SGIModelReference'] } }

##
# @SGIModelReference:
#
# A documented reference configuration retained for comparison.
# The emulator cannot build it, and a launcher cannot select it.
#
# @name: stable configuration name
# @product: product family
# @display-name: human-readable configuration name
# @description: authored description and known limitations
#
# Since: 11.2
##
{ 'struct': 'SGIModelReference',
  'data': { 'name': 'str',
            'product': 'str',
            'display-name': 'str',
            'description': 'str' } }

##
# @query-sgi-machines:
#
# Return the compiled SGI machine catalogue: the same
# document embedded into this emulator at build time, so a package
# build can read it back from the emulator it ships rather than
# carrying its own copy out of band.
#
# Returns: the compiled catalogue
#
# Since: 11.2
##
{ 'command': 'query-sgi-machines',
  'returns': 'SGIMachines' }
