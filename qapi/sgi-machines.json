            'initiator-region': 'uint8',
            'installed-bank-mask': 'uint8' } }

##
# @SGIModelL1Config:
#
# Reported identity and allowed inputs for a node's shared controller.
#
# @cpu-context: selected firmware inputs for the node board's CPU
