##
{ 'struct': 'SGIModelRouter',
  'data': { 'id': 'str',
            'module-index': 'uint32',
            'slot': 'uint32',
            'part': 'uint16',
            'revision': 'uint8',
            'chip-inputs': 'uint8',
            'serial': 'uint64',
            '*synthetic-diagnostics': 'bool' } }

