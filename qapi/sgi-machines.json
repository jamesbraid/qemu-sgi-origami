# @role: processor, system-board, frontplane or power-supply
#
# @barcode: virtual board barcode
#
# @part: fitted board part number
#
# @revision: fitted board revision
#
# @name: board record name
#
# @serial: virtual one-wire ROM serial
#
# Since: 11.2
##
{ 'struct': 'SGIModelBoardRecord',
  'data': { 'role': 'str', 'barcode': 'str', 'part': 'str',
            'revision': 'str', 'name': 'str', 'serial': 'uint64' } }

##
