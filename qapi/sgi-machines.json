##
# @SGIModelIoAssembly:
#
# Versioned synthetic construction policy, separate from physical
#     topology.
#
# @version: Descriptor version; only 1 is supported.
#
# @kind: Explicit assembly implementation.
#
# @peer-index: Position in the topology I/O peer array.
#
# @module-index: Owning module position, cross-checked with the peer.
#
# @controller-index: Owning module L1 controller position.
#
# @placement: Immutable address-space placement, separate from LB
#     identity.
#
# @initial-node-number: Explicit guest-visible LB reset number; zero
#     is unassigned.
#
# @bedrock-revision: Explicit inferred Bedrock revision 2.
#
# @xbridge-revision: Explicit inferred XBridge revision 2.
#
# @head-ports: Four distinct U1 E/F and U2 E/F upstream ports.
#
# @controller-profile: Explicit pci-expansion controller profile.
#
# @bic-identity: Synthetic whole BIC identity with expansion field
#     0xc000.
#
# @controller-startup: Optional functional startup experiment.
#     Omission performs no controller assignment.
#
# @main-power: Optional functional main-power experiment.
#     Requires @initial-main-power; omission preserves existing
#     behavior.
#
# @configuration-storage: Optional caller-backed storage.
#     Requires @main-power and an explicit runtime image
#     binding.
#
# @pending-register-experiment: Synthetic BIC pending-register
#     processor visibility without CPU outputs.
#
# @unconnected-uart: Synthetic UART without a backend or packet
#     service.
#     Requires selected configuration storage.
#
# @initial-main-power: Explicit initial main-power state.
#     Requires @main-power.
#
# @power-command-issuer: Optional compute L1 controller index allowed
#     to forward power commands.  Requires @main-power.
#
# @initial-latch: Optional synthetic latch; omission starts unknown.
#
# @intx-map: Optional 48-entry synthetic board-owned PCI interrupt
#     map.
#
# Since: 11.2
##
{ 'struct': 'SGIModelIoAssembly',
  'data': { 'version': 'uint32',
            'kind': 'SGIModelIoAssemblyKind',
            'peer-index': 'uint32',
            'module-index': 'uint32',
            'controller-index': 'uint32',
            'placement': 'uint32',
            'initial-node-number': 'uint8',
            'bedrock-revision': 'uint8',
            'xbridge-revision': 'uint8',
            'head-ports': ['uint8'],
            'controller-profile': 'str',
            'bic-identity': 'uint64',
            '*controller-startup': 'SGIModelControllerStartup',
            '*main-power': 'SGIModelMainPower',
            '*configuration-storage': 'SGIModelConfigurationStorage',
            '*unconnected-uart': 'bool',
            '*pending-register-experiment': 'bool',
            '*power-command-issuer': 'uint32',
            '*initial-main-power': 'bool',
            '*initial-latch': 'uint16',
            '*intx-map': ['uint8'] } }

