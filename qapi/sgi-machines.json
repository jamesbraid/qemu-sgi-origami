#
# @cpu-mode-word: full 32-bit firmware Config0 word
# @cpu-clock-hz: selected processor clock
# @hub-clock-hz: selected Hub clock
#
# Since: 11.2
##
{ 'struct': 'SGIModelL1CPUContext',
  'data': { 'cpu-mode-word': 'uint32',
            'cpu-clock-hz': 'uint64',
            'hub-clock-hz': 'uint64' } }

