##
# *********************
# SGI machine catalogue
# *********************
#
# The record types of the compiled machine catalogue (`hw/mips/sgi/
# sgi-machines.json`, embedded into the emulator at build time): one
# `topologies` entry per configuration the SGI Scalable Node family
# builder can construct, and one `offerings` entry per accepted CPU
# population a launcher may select.  A `topologies` record carries
# only what a machine description is responsible for:
# which devices are present, where each plugs in, and a fitted part's
# own identity, revision or size.  A fact the same on every machine
# fitting one chip -- a PCI function's position, an I2C address, a
# crossbar's manufacturer id, a Router's port count, a flash's named
# views, an XIO attachment's decode mask -- is a device fact
# instead, fixed in the device model that already owns it.  An
# `offerings` record carries what a launcher may choose, unfiltered by
# that rule: the accepted CPU and memory populations, the firmware
# images and writable stores a machine needs, storage controllers,
# and console and network placement.
##

##
# @SGIModelAsicKind:
#
# Which node ASIC a node board is built around.
#
# @hub: the SN0 (IP27/IP29) Hub
#
# @heart: the IP30 HEART controller
#
# @bedrock: the SN1 (IP35) Bedrock
#
# Since: 11.2
##
{ 'enum': 'SGIModelAsicKind',
  'data': ['hub', 'bedrock', 'heart'] }

##
# @SGIModelProcessor:
#
# One catalogued processor assembly: identity registers and cache
# facts a fitted part contributes to KLCONFIG and the flash
# configuration block's mode word.
#
# @id: catalogue id of this assembly
#
# @kind: processor family name (R10000, R12000, R14000, ...)
#
# @prid: CP0 PRId register value
#
# @fpu-prid: FPU implementation/revision register value
#
# @clock-hz: core clock
#
# @cache-clock-hz: secondary cache clock
#
# @cache-mib: secondary cache size
#
# @required-properties: CPU properties the launcher must set
#     explicitly for this assembly
#
# @mode-bits: the CP0_Config0-derived mode word the flash
#     configuration block and the board latch both compare against,
#     computed once by the catalogue compiler from this
#     assembly's other fields; for an IP30 R12000, the Config bits
#     24:0 its CPU samples at cold reset
#
# Since: 11.2
##
{ 'struct': 'SGIModelProcessor',
  'data': { 'id': 'str',
            'kind': 'str',
            '*prid': 'uint32',
            '*fpu-prid': 'uint32',
            'clock-hz': 'uint64',
            '*cache-clock-hz': 'uint64',
            'cache-mib': 'uint16',
            '*required-properties': ['str'],
            '*mode-bits': 'uint32' } }

##
# @SGIModelProcessorOption:
#
# One processor module a launch may select with `processor=`, in place
# of the topology's default part.
#
# @assembly: the processor every fitted slot then holds; its @id is
#     the `processor=` value
#
# @accepted-memory-mib: the per-node memory sizes accepted with it,
#     which replace each node's @accepted-memory-mib
#
# @cpus-per-node: the processor counts a node may fit with it
#
# Since: 11.2
##
{ 'struct': 'SGIModelProcessorOption',
  'data': { 'assembly': 'SGIModelProcessor',
            'accepted-memory-mib': ['uint64'],
            'cpus-per-node': ['uint32'] } }

##
# @SGIModelCpuSlot:
#
# One processor-interface slot on a node board.
#
# @interface: which of the ASIC's processor interfaces this slot is on
#
# @slot: position on that interface
#
# @assembly: the fitted processor, absent for an unpopulated slot
#
# Since: 11.2
##
{ 'struct': 'SGIModelCpuSlot',
  'data': { 'interface': 'uint32',
            'slot': 'uint32',
            '*assembly': 'SGIModelProcessor' } }

##
# @SGIModelFlashKind:
#
# Which boot-flash chip a node board carries.
#
# @operator-prom: raw operator-supplied image; physical chip
#     unidentified
#
# @am29f080: AMD Am29F080 (or a pin-compatible part)
#
# Since: 11.2
##
{ 'enum': 'SGIModelFlashKind',
  'data': ['am29f080', 'operator-prom'] }

##
# @SGIModelFlash:
#
# A node board's boot flash.  Which named execution or maintenance
# views the flash controller answers, and their addresses, are fixed
# by the node ASIC and are not carried here; the node device (`sn0.c`
# for HUB, `sn1-node.c` for BEDROCK) names them itself.
#
# @kind: the fitted chip
#
# @size: total chip size in bytes
#
# @select: an IP30 boot flash's Bridge flash select: true for select
#     1.  The machine's flash-select property defaults to it.  Absent
#     on the SN nodes, which have no select
#
# @strap: an IP30 board's flash select strap: true boots from select
#     1.  The machine's flash-strap property defaults to it
#
# Since: 11.2
##
{ 'struct': 'SGIModelFlash',
  'data': { 'kind': 'SGIModelFlashKind',
            'size': 'uint64',
            '*select': 'bool',
            '*strap': 'bool' } }

##
# @SGIModelAsicIdentity:
#
# A node ASIC's own fitted-part identity.  The Hub's embedded I2C
# controller and system-controller role are named here when it carries
# one; their bus addresses are chip constants and are not carried (a
# Bedrock node, whose controller role belongs to its module's or
# brick's L1 instead, reports both false).
#
# @ni-revision: NUMAlink interface revision, required for a Hub
#
# @widget-revision: XIO widget revision answered by this ASIC's port;
#     required for a Hub
#
# @serial: fitted-part one-wire serial
#
# @i2c-controller: whether this ASIC carries an embedded I2C
#     controller
#
# @system-controller: whether that controller also answers as the
#     node's system controller (Origin 200's embedded ELSC)
#
# @clock-hz: explicitly authored Bedrock core clock in hertz, present
#     only for a reviewed IP53 construction
#
# Since: 11.2
##
{ 'struct': 'SGIModelAsicIdentity',
  'data': { '*ni-revision': 'uint8',
            '*widget-revision': 'uint8',
            '*clock-hz': 'uint64',
            'serial': 'uint64',
            'i2c-controller': 'bool',
            'system-controller': 'bool' } }

##
# @SGIModelBoardRecord:
#
# A reviewed virtual board identity, not a measured physical serial.
