#
# @gpio-classic: IOC3's board-wired classic-product input
#
# @board-records: virtual identities of the fitted boards
#
# Since: 11.2
##
{ 'struct': 'SGIModelHeartIdentity',
  'data': { 'widget-revision': 'uint8', 'widget-id-64': 'uint64',
            'widget-status-f-measured': 'bool', 'gpio-classic': 'bool',
