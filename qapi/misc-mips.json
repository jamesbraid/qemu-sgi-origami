##
# @SgiOriginCpuState:
#
# Non-stop diagnostic state for one Origin processor.
#
# @index: global CPU index
#
# @interrupt-request: pending generic CPU interrupt bits
#
# Since: 11.2
##
{ 'struct': 'SgiOriginCpuState',
  'data': { 'index': 'int',
            'interrupt-request': 'uint32' } }

##
# @SgiOriginPcf8584State:
#
# Internal state of one Origin Hub's PCF8584 I2C controller.
#
# @data: data register
#
# @control: control register
#
# @status: status register
#
# @transfer: current transfer phase
#
# @receiving: whether the controller is receiving
#
# @start-pending: whether a START is pending
#
# @address-staged: whether an address is staged
#
# @address: current seven-bit bus address
#
# Since: 11.2
##
{ 'struct': 'SgiOriginPcf8584State',
  'data': { 'data': 'uint8',
            'control': 'uint8',
            'status': 'uint8',
            'transfer': 'bool',
            'receiving': 'bool',
            'start-pending': 'bool',
            'address-staged': 'bool',
            'address': 'uint8' } }

##
# @SgiOriginElscState:
#
# Internal queue and arbitration state of one Origin ELSC.
#
# @rx-length: received request bytes
#
# @tx-length: response bytes
#
# @tx-position: next response byte
#
# @arbitration-code: current arbitration code
#
# @arbitration-present: whether the arbitration signal is asserted
#
# @queue-length: queued console input bytes
#
# Since: 11.2
##
{ 'struct': 'SgiOriginElscState',
  'data': { 'rx-length': 'uint32',
            'tx-length': 'uint32',
            'tx-position': 'uint32',
            'arbitration-code': 'uint32',
            'arbitration-present': 'bool',
            'queue-length': 'uint32' } }

##
# @SgiOriginHubState:
#
# Non-stop diagnostic state for one Origin Hub and its controller bus.
#
# @node: machine node index
#
# @nasid: programmed node identifier
#
# @cpu-a-enabled: whether processor A is enabled
#
# @cpu-b-enabled: whether processor B is enabled
#
# @pending0: first Hub interrupt pending bank
#
# @pending1: second Hub interrupt pending bank
#
# @mask-a0: processor A mask for pending bank zero
#
# @mask-a1: processor A mask for pending bank one
#
# @mask-b0: processor B mask for pending bank zero
#
# @mask-b1: processor B mask for pending bank one
#
# @rt-compare-a: processor A real-time comparator
#
# @rt-compare-b: processor B real-time comparator
#
# @rt-pending-a: processor A comparator pending bit
#
# @rt-pending-b: processor B comparator pending bit
#
# @rt-enabled-a: processor A comparator interrupt enable
#
# @rt-enabled-b: processor B comparator interrupt enable
#
# @pcf8584: I2C controller state
#
# @elsc: system-controller state
#
# Since: 11.2
##
{ 'struct': 'SgiOriginHubState',
  'data': { 'node': 'int',
            'nasid': 'uint32',
            'cpu-a-enabled': 'bool',
            'cpu-b-enabled': 'bool',
            'pending0': 'uint64',
            'pending1': 'uint64',
            'mask-a0': 'uint64',
            'mask-a1': 'uint64',
            'mask-b0': 'uint64',
            'mask-b1': 'uint64',
            'rt-compare-a': 'uint64',
            'rt-compare-b': 'uint64',
            'rt-pending-a': 'bool',
            'rt-pending-b': 'bool',
            'rt-enabled-a': 'bool',
            'rt-enabled-b': 'bool',
            'pcf8584': 'SgiOriginPcf8584State',
            'elsc': 'SgiOriginElscState' } }

##
# @SgiOriginFlightEvent:
#
# One recent Origin device transition.
#
# @sequence: machine-wide event sequence
#
# @virtual-time-ns: QEMU virtual-clock timestamp
#
# @node: machine node index
#
# @component: device that recorded the transition
#
# @operation: operation that caused the transition
#
# @address: device-local address or register identifier
#
# @value: transferred value
#
# @size: access width in bytes
#
# @cpu-index: issuing processor index, for vCPU MMIO accesses
#
# @pc: issuing processor's store or load PC, for vCPU MMIO accesses
#
# @before: packed device state before the transition, when applicable
#
# @after: packed device state after the transition, when applicable
#
# Since: 11.2
##
{ 'struct': 'SgiOriginFlightEvent',
  'data': { 'sequence': 'uint64',
            'virtual-time-ns': 'int64',
            'node': 'int',
            'component': 'str',
            'operation': 'str',
            'address': 'uint64',
            'value': 'uint64',
            'size': 'uint8',
            '*cpu-index': 'int',
            '*pc': 'uint64',
            '*before': 'uint64',
            '*after': 'uint64' } }

##
# @SgiOriginFlightRecorder:
#
# Bounded recent Origin device transitions.
#
# @enabled: whether the machine is recording transitions
#
# @next-sequence: sequence assigned to the next event
#
# @dropped: events overwritten after the ring filled
#
# @events: retained events ordered oldest to newest
#
# A machine reset discards earlier history and device reset activity
# before the guest resumes.
#
# Since: 11.2
##
{ 'struct': 'SgiOriginFlightRecorder',
  'data': { 'enabled': 'bool',
            'next-sequence': 'uint64',
            'dropped': 'uint64',
            'events': ['SgiOriginFlightEvent'] } }

##
# @SgiOriginState:
#
# Non-stop diagnostic state for an SGI Origin machine.  The CPU list
# contains immutable identity and atomically observed interrupt bits.
# The command does not read live architectural registers under MTTCG.
#
# @query-sequence: sequence number incremented for each query
#
# @cpus: processor observations
#
# @hubs: Hub and controller-bus observations
#
# @flight-recorder: recent device transitions
#
# Since: 11.2
##
{ 'struct': 'SgiOriginState',
  'data': { 'query-sequence': 'uint64',
            'cpus': ['SgiOriginCpuState'],
            'hubs': ['SgiOriginHubState'],
            'flight-recorder': 'SgiOriginFlightRecorder' } }

##
# @x-query-origin-state:
#
# Return live SGI Origin diagnostics without stopping the machine.
# The command does not wait for a vCPU rendezvous.
#
# @event-limit: newest flight-recorder events to return, up to 4096
#     (default: 256)
#
# Features:
#
# @unstable: This command is meant for debugging.  It returns a
#     structured description rather than human-readable text because
#     the emulator's own tooling parses it.
#
# Returns: the machine's live Origin state
#
# Errors:
#     - If @event-limit exceeds 4096
#     - If the running machine is not an SGI Origin
#
# Since: 11.2
##
{ 'command': 'x-query-origin-state',
  'data': { '*event-limit': 'uint32' },
  'returns': 'SgiOriginState',
  'features': [ 'unstable' ] }

##
# @MipsDebugBreakpoint:
#
# One breakpoint planted by @x-mips-debug-breakpoint.
#
# @cpu-index: CPU the breakpoint is planted on
#
# @pc: virtual address the breakpoint matches
#
# @asid: EntryHi ASID the CPU must hold for the breakpoint to fire
#
# @exccode: Cause.ExcCode the CPU must hold for the breakpoint to fire
#
# Since: 11.2
##
{ 'struct': 'MipsDebugBreakpoint',
  'data': { 'cpu-index': 'int',
            'pc': 'uint64',
            '*asid': 'uint16',
            '*exccode': 'uint8' } }

##
# @x-mips-debug-breakpoint:
#
# Plant or remove a breakpoint on one MIPS CPU that fires only while
# the CPU holds a given EntryHi ASID and Cause.ExcCode.  A hit stops
# the machine in the debug run state and an attached gdb sees SIGTRAP
# there; a hit whose filters do not match runs on at full speed.  The
# next resume after a hit runs past the stop PC without firing again
# for that stop.  The CPU's breakpoint table is changed on its own
# thread, and planting queues a translation-block flush so blocks
# already chained through @pc cannot skip the check.  The table is
# host debug state and is not migrated.
#
# @cpu-index: CPU to plant the breakpoint on
#
# @pc: virtual address to stop at
#
# @asid: fire only while the EntryHi ASID field holds this value
#
# @exccode: fire only while Cause.ExcCode holds this value
#
# @remove: remove the breakpoint planted with exactly these arguments
#     instead of planting one (default: false)
#
# Features:
#
# @unstable: This command is meant for debugging.
#
# Errors:
#     - If @cpu-index names no CPU
#     - If @asid does not fit the CPU's ASID field or @exccode exceeds
#       31
#     - If the CPU's breakpoint table is full
#     - If the breakpoint is already planted, or is not planted on
#       removal
#
# Since: 11.2
##
{ 'command': 'x-mips-debug-breakpoint',
  'data': { 'cpu-index': 'int',
            'pc': 'uint64',
            '*asid': 'uint16',
            '*exccode': 'uint8',
            '*remove': 'bool' },
  'features': [ 'unstable' ] }

##
# @x-query-mips-debug-breakpoints:
#
# List the breakpoints planted by @x-mips-debug-breakpoint on every
# CPU.
#
# Features:
#
# @unstable: This command is meant for debugging.
#
# Returns: the planted breakpoints in CPU index order
#
# Since: 11.2
##
{ 'command': 'x-query-mips-debug-breakpoints',
  'returns': ['MipsDebugBreakpoint'],
  'features': [ 'unstable' ] }

##
# @MipsTlbEntry:
#
# One entry of a MIPS CPU's TLB as the emulator holds it.
#
# @index: position in the TLB; positions at or past the architectural
#     entry count are the emulator's shadow copies of entries a random
#     write displaced
#
# @vpn2: virtual address of the even page of the pair, as EntryHi
#     holds it
#
# @asid: address space the entry belongs to
#
# @global: whether the entry matches every ASID
#
# @page-mask: PageMask register value the entry was written with
#
# @pfn0: physical address of the even page
#
# @valid0: whether the even page is valid
#
# @dirty0: whether the even page is writable
#
# @cache0: cache coherency attribute of the even page
#
# @uc0: uncached attribute of the even page, on the R10000 family
#
# @pfn1: physical address of the odd page
#
# @valid1: whether the odd page is valid
#
# @dirty1: whether the odd page is writable
#
# @cache1: cache coherency attribute of the odd page
#
# @uc1: uncached attribute of the odd page, on the R10000 family
#
# Since: 11.2
##
{ 'struct': 'MipsTlbEntry',
  'data': { 'index': 'int',
            'vpn2': 'uint64',
            'asid': 'uint16',
            'global': 'bool',
            'page-mask': 'uint32',
            'pfn0': 'uint64',
            'valid0': 'bool',
            'dirty0': 'bool',
            'cache0': 'uint8',
            'uc0': 'uint8',
            'pfn1': 'uint64',
            'valid1': 'bool',
            'dirty1': 'bool',
            'cache1': 'uint8',
            'uc1': 'uint8' } }

##
# @MipsTlbState:
#
# One MIPS CPU's TLB and the CP0 registers that address it.
#
# @cpu-index: CPU the state was read from
#
# @entryhi: EntryHi register
#
# @asid: ASID field of EntryHi
#
# @index: Index register
#
# @wired: Wired register
#
# @nb-tlb: number of architectural entries
#
# @tlb-in-use: architectural entries plus the emulator's shadow copies
#
# @entries: entries in index order
#
# Since: 11.2
##
{ 'struct': 'MipsTlbState',
  'data': { 'cpu-index': 'int',
            'entryhi': 'uint64',
            'asid': 'uint16',
            'index': 'uint32',
            'wired': 'uint32',
            'nb-tlb': 'uint32',
            'tlb-in-use': 'uint32',
            'entries': ['MipsTlbEntry'] } }

##
# @x-query-mips-tlb:
#
# Read one MIPS CPU's TLB and TLB-related CP0 registers.  Unlike
# @x-query-origin-state this reads live architectural state: the read
# runs on the CPU's own thread between two instructions, so a running
# CPU is briefly interrupted and the result is one consistent
# snapshot.
#
# @cpu-index: CPU to read
#
# @shadow: also return the emulator's shadow copies of entries a
#     random write displaced, which follow the architectural entries
#     (default: false)
#
# Features:
#
# @unstable: This command is meant for debugging.
#
# Returns: the CPU's TLB state
#
# Errors:
#     - If @cpu-index names no CPU
#     - If the CPU has no standard TLB
#
# Since: 11.2
##
{ 'command': 'x-query-mips-tlb',
  'data': { 'cpu-index': 'int',
            '*shadow': 'bool' },
  'returns': 'MipsTlbState',
  'features': [ 'unstable' ] }
