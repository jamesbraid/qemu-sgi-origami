#
# One cable joining two ports.
#
# @name: catalogue name of this cable
#
# @kind: what kind of cable it is
#
# @ends: the two ports it joins
#
# Since: 11.2
##
{ 'struct': 'SGIModelCable',
  'data': { 'name': 'str',
            'kind': 'SGIModelCableKind',
            'ends': ['SGIModelLinkEnd'] } }

##
# @SGIModelCrossbarKind:
#
# Which crosstalk switch a crossbar record describes.
#
# @xbow: a standalone Crossbow chip
#
# @xbridge: an XBridge's own internal crossbar section
#
# Since: 11.2
##
{ 'enum': 'SGIModelCrossbarKind',
  'data': ['xbow', 'xbridge'] }

##
# @SGIModelCrossbar:
#
# One crosstalk switch.  Its manufacturer id, part number and
# initially-populated-links mask are fixed by @kind and are not
# carried here.
#
# @id: catalogue id of this crossbar
#
# @module-index: position in the topology's own @modules list
#
# @kind: which crosstalk switch this is
#
# @widget-revision: fitted silicon revision
#
# Since: 11.2
##
{ 'struct': 'SGIModelCrossbar',
  'data': { 'id': 'str',
            'module-index': 'uint32',
            'kind': 'SGIModelCrossbarKind',
            'widget-revision': 'uint8' } }

##
# @SGIModelXtalkAttachment:
#
# Which node hosts a crosstalk widget: through a crossbar's numbered
# link, or, with no crossbar between the node and the widget, a direct
# attachment.  A direct attachment's decode mask and discovery widget
# are fixed by the chip that answers it and are not carried here.
#
# @crossbar-index: position in the topology's own @crossbars list, or
#     -1 for a direct attachment
#
# @widget: widget number this attachment answers on
#
# @node-index: position in the topology's own @nodes list
#
# Since: 11.2
##
{ 'struct': 'SGIModelXtalkAttachment',
  'data': { 'crossbar-index': 'int',
            'widget': 'uint32',
            'node-index': 'uint32' } }

##
# @SGIModelXtalkSlot:
#
# One physical crosstalk connector position.  A slot does not imply
