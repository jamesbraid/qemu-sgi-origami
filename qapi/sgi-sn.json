##
# ***********************************
# SGI Scalable Node compiled catalogue
# ***********************************
#
# The record types of Origami's compiled catalogue (`hw/mips/sgi/
# sn-catalogue.json`, embedded into the emulator at build time): one
# `topologies` entry per configuration the SGI Scalable Node family
# builder can construct, and one `offerings` entry per accepted CPU
# population a launcher may select.  A `topologies` record carries
# only what decision D-0026
# (docs/decisions/D-0026-machine-description- ownership.md in the
# Origami repository) keeps a machine description responsible for:
# which devices are present, where each plugs in, and a fitted part's
# own identity, revision or size.  A fact the same on every machine
# fitting one chip -- a PCI function's position, an I2C address, a
# crossbar's manufacturer id, a Router's port count, a flash's named
# views, a crosstalk attachment's decode mask -- is a device fact
# instead, fixed in the device model that already owns it.  An
# `offerings` record carries what a launcher may choose, unfiltered by
# that rule: the accepted CPU and memory populations, firmware kind
# and size, storage controllers, console and network placement, and
# the QEMU argument each becomes.
##

##
# @SGIModelAsicKind:
#
# Which node ASIC a node board is built around.
#
# @hub: the SN0 (IP27/IP29) Hub
#
# @bedrock: the SN1 (IP35) Bedrock
#
# Since: 11.2
##
{ 'enum': 'SGIModelAsicKind',
  'data': ['hub', 'bedrock'] }

##
# @SGIModelProcessor:
#
# One catalogued processor assembly: identity registers and cache
# facts a fitted part contributes to KLCONFIG and the flash
# configuration block's mode word.
#
# @id: catalogue id of this assembly
#
# @kind: processor family name (R10000, R12000, R14000, ...)
#
# @prid: CP0 PRId register value
#
# @fpu-prid: FPU implementation/revision register value
#
# @clock-hz: core clock
#
# @cache-clock-hz: secondary cache clock
#
# @cache-mib: secondary cache size
#
# @mode-bits: the CP0_Config0-derived mode word the flash
#     configuration block and the board latch both compare against,
#     computed once by Origami's compiler from this assembly's other
#     fields
#
# Since: 11.2
##
{ 'struct': 'SGIModelProcessor',
  'data': { 'id': 'str',
            'kind': 'str',
            'prid': 'uint32',
            'fpu-prid': 'uint32',
            'clock-hz': 'uint64',
            'cache-clock-hz': 'uint64',
            'cache-mib': 'uint16',
            'mode-bits': 'uint32' } }

##
# @SGIModelCpuSlot:
#
# One processor-interface slot on a node board.
#
# @interface: which of the ASIC's processor interfaces this slot is on
#
# @slot: position on that interface
#
# @assembly: the fitted processor, absent for an unpopulated slot
#
# Since: 11.2
##
{ 'struct': 'SGIModelCpuSlot',
  'data': { 'interface': 'uint32',
            'slot': 'uint32',
            '*assembly': 'SGIModelProcessor' } }

##
# @SGIModelFlashKind:
#
# Which boot-flash chip a node board carries.
#
# @am29f080: AMD Am29F080 (or a pin-compatible part)
#
# Since: 11.2
##
{ 'enum': 'SGIModelFlashKind',
  'data': ['am29f080'] }

##
# @SGIModelFlash:
#
# A node board's boot flash.  Which named execution or maintenance
# views the flash controller answers, and their addresses, are fixed
# by the node ASIC and are not carried here; the node device (`sn0.c`
# for HUB, `sn1-node.c` for BEDROCK) names them itself.
#
# @kind: the fitted chip
#
# @size: total chip size in bytes
#
# Since: 11.2
##
{ 'struct': 'SGIModelFlash',
  'data': { 'kind': 'SGIModelFlashKind',
            'size': 'uint64' } }

##
# @SGIModelAsicIdentity:
#
# A node ASIC's own fitted-part identity.  The Hub's embedded I2C
# controller and system-controller role are named here when it carries
# one; their bus addresses are chip constants and are not carried (a
# Bedrock node, whose controller role belongs to its module's or
# brick's L1 instead, reports both false).
#
# @ni-revision: NUMAlink interface revision
#
# @widget-revision: crosstalk widget revision this ASIC's port answers
#
# @serial: fitted-part one-wire serial
#
# @i2c-controller: whether this ASIC carries an embedded I2C
#     controller
#
# @system-controller: whether that controller also answers as the
#     node's system controller (Origin 200's embedded ELSC)
#
# Since: 11.2
##
{ 'struct': 'SGIModelAsicIdentity',
  'data': { 'ni-revision': 'uint8',
            'widget-revision': 'uint8',
            'serial': 'uint64',
            'i2c-controller': 'bool',
            'system-controller': 'bool' } }

##
# @SGIModelNode:
#
# One node board: a node ASIC, its populated processor slots, its
# memory banks and its boot flash.
#
# @id: catalogue id of this node
#
# @module-index: position in the topology's @modules list
#
# @slot: physical slot number within that module
#
# @asic-kind: which node ASIC this board is built around
#
# @identity: the ASIC's own fitted-part identity
#
# @cpu-slots: this node's processor-interface slots, populated and
#     empty
#
# @bank-mib: this node's memory banks, in bank order; a zero entry is
#     an unpopulated bank.  Always exactly as many entries as the node
#     ASIC's architectural bank count.
#
# @accepted-memory-mib: other total per-node memory sizes the
#     builder's fitting rule accepts for this node besides @bank-mib's
#     own shipped population; empty means the shipped population only
#
# @flash: this node's boot flash
#
# @slave-role: whether this node answers module-management commands
#     only through its module's master, never on its own external AUX
#     line (Origin 2000's per-Hub adapters behind a shared MSC)
#
# Since: 11.2
##
{ 'struct': 'SGIModelNode',
  'data': { 'id': 'str',
            'module-index': 'uint32',
            'slot': 'uint32',
            'asic-kind': 'SGIModelAsicKind',
            'identity': 'SGIModelAsicIdentity',
            'cpu-slots': ['SGIModelCpuSlot'],
            'bank-mib': ['uint64'],
            'accepted-memory-mib': ['uint64'],
            'flash': 'SGIModelFlash',
            'slave-role': 'bool' } }

##
# @SGIModelRouter:
#
# One Router board.  Its port count is fixed by the chip and is not
# carried here.
#
# @id: catalogue id of this router
#
# @module-index: position in the topology's @modules list
#
# @slot: physical slot number within that module
#
# @part: NIC manufacturing part number
#
# @revision: fitted silicon revision
#
# @chip-inputs: fitted-part NUMAlink input calibration count, read
#     back through the Router's own status register
#
# @serial: fitted-part one-wire serial
#
# Since: 11.2
##
{ 'struct': 'SGIModelRouter',
  'data': { 'id': 'str',
            'module-index': 'uint32',
            'slot': 'uint32',
            'part': 'uint16',
            'revision': 'uint8',
            'chip-inputs': 'uint8',
            'serial': 'uint64' } }

##
# @SGIModelLinkEndKind:
#
# What a cable's end plugs into.
#
# @node: a node board's own network port
#
# @router: a numbered Router port
#
# Since: 11.2
##
{ 'enum': 'SGIModelLinkEndKind',
  'data': ['node', 'router'] }

##
# @SGIModelLinkEnd:
#
# One end of a cable.
