#
# @id: canonical component identifier from the machine model
#
# @crossbar-index: position in the topology's own @crossbars list
#
# @widget: widget number assigned to this physical position
#
# @controlling-node: position in the topology's own @nodes list of the
#     node that controls this position
#
# Since: 11.2
##
{ 'struct': 'SGIModelXtalkSlot',
  'data': { 'id': 'str',
            'crossbar-index': 'uint32',
            'widget': 'uint32',
            'controlling-node': 'uint32' } }

##
# @SGIModelIoBoardPreset:
#
# Which base I/O board design a board record fits: the functions each
# preset's Bridge carries are a design fact of the board and are not
# carried here (`sgi-baseio`'s own preset table does).
#
# @ip29-io: Origin 200's integrated IP29 System Board I/O
#
# @ip29-io-crosstown: the same IP29 I/O with the GIGAchannel's
#     Crosstown extension board fitted in place of the XTalk jumper,
#     which adds its own board record beside the IP29's
#
# @io6: the Origin 2000/Onyx2 plain BaseIO XIO card
#
# @io6g: the Origin 2000/Onyx2 BaseIO-G XIO card, whose MediaIO
#     daughtercard adds a second IOC3 (keyboard, mouse, two serial
#     ports and a parallel port, no ethernet) alongside the plain
#     @io6 board's own
#
# @io8: the Origin 300 IO-8
#
# @io9: the IO-9
#
# @pci-shoehorn: the Origin 2000 PCI-XTALK ADAPTER (PCI shoehorn), a
#     removable XIO card carrying one PCI card, fitted with an SGI Cad
#     Duo input card
#
# @pci-carrier: the Origin 2000 PCI Carrier Assembly, a removable XIO
#     card with three empty PCI slots
#
# Since: 11.2
##
{ 'enum': 'SGIModelIoBoardPreset',
  'data': ['ip29-io', 'ip29-io-crosstown', 'io6', 'io6g', 'io8', 'io9',
           'pci-shoehorn', 'pci-carrier'] }

##
# @SGIModelIoBoardCarrier:
#
# What physically carries a base I/O board.
#
# @onboard: a fitted part of the node board itself (Origin 200's IP29
#     System Board)
#
# @xio-slot: a removable XIO card
#
# @machine-placed: a PCI board the machine places outright, not a
#     removable card (Origin 300's IO-8, on the node board's own
#     XBridge)
#
# Since: 11.2
##
{ 'enum': 'SGIModelIoBoardCarrier',
  'data': ['onboard', 'xio-slot', 'machine-placed'] }

##
# @SGIModelIoBoard:
#
# One base I/O board.  A PCI function's own position, interrupt input
# and IOC3 population flags are device facts @preset already implies
# and are not carried here.
#
# @id: catalogue id of this board
#
# @module-index: position in the topology's own @modules list
#
# @preset: which base I/O board design is fitted
#
# @carrier: what physically carries it
#
# @attachment: physical slot or head label
#
# @part: fitted-part design number
#
# @revision: fitted-part revision
#
# @serial: fitted-part one-wire serial
#
# @ioc3-serial: the IOC3 function's own one-wire serial, a distinct
#     fitted-part identity from the board's own @serial; absent where
#     this board's preset carries no IOC3 population (an Origin 300
#     XBridge head with nothing fitted)
#
# Since: 11.2
##
{ 'struct': 'SGIModelIoBoard',
  'data': { 'id': 'str',
            'module-index': 'uint32',
            'preset': 'SGIModelIoBoardPreset',
            'carrier': 'SGIModelIoBoardCarrier',
            'attachment': 'uint32',
            'part': 'str',
            'revision': 'uint8',
            'serial': 'uint64',
            '*ioc3-serial': 'uint64' } }

