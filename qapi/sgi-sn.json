##
# @SGIModelTopology:
#
# One authored configuration: a product's wiring and its shipped and
# accepted populations.
#
# @name: catalogue name of this topology (`topology=` selects it)
#
# @product: which product this topology is a configuration of (`-M`
#     value); not a device or wiring fact, but what a loaded catalogue
#     needs to pick a product's default topology without a second,
#     hand-authored table
#
# @generation: which Scalable Node generation this topology's node
#     boards belong to
#
# @description: prose description of this configuration
#
# @nodes: this topology's node boards
#
# @modules: this topology's modules or bricks
#
# @routers: this topology's Router boards
#
# @cables: this topology's cables
#
# @crossbars: this topology's crosstalk switches
#
# @xtalk-attachments: which node hosts each crosstalk widget
#
# @xtalk-slots: physical crosstalk connector positions, whether
#     populated or not
#
# @io-boards: this topology's base I/O boards
#
# @controllers: this topology's shared system controllers
#
# @console: position in @nodes of the node whose IOC3 port A (SN0) or
#     brick controller (SN1) the firmware treats as its console; the
#     rest of the serial-line order is a builder rule, not data here
#
# @junk-uart: position in @nodes of the node that offers the
#     manufacturing junk-bus UART when the junk-uart property is set,
#     or -1 where this topology has none
#
# @supported-cpu-populations: every `-smp`/`-numa` population the
#     builder accepts for this topology
#
# Since: 11.2
##
{ 'struct': 'SGIModelTopology',
  'data': { 'name': 'str',
            'product': 'str',
            'generation': 'SGIModelGeneration',
            'description': 'str',
            'nodes': ['SGIModelNode'],
            'modules': ['SGIModelModule'],
            'routers': ['SGIModelRouter'],
            'cables': ['SGIModelCable'],
            'crossbars': ['SGIModelCrossbar'],
            'xtalk-attachments': ['SGIModelXtalkAttachment'],
            'xtalk-slots': ['SGIModelXtalkSlot'],
            'io-boards': ['SGIModelIoBoard'],
            'controllers': ['SGIModelController'],
            'console': 'int',
            'junk-uart': 'int',
            'supported-cpu-populations': ['SGIModelCpuPopulation'] } }

