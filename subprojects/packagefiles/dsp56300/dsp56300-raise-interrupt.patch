+/// Raise the interrupt at byte offset `vector` in the vector table (0x10,
+/// 0x12, ... as the manual lists them) at priority `ipl`: 0 to 2 for a
+/// maskable source, 3 for a non-maskable one. An edge request (`level`
+/// false) is cleared when the core takes it. A level request stays pending
+/// until `dsp56300_lower_interrupt`, so the core takes it again after the
+/// handler returns while the condition holds. Safe to call from a memory
+/// callback: the interrupt pipeline is not a register the compiled code
+/// caches across the call.
+///
+/// # Safety
+/// `dsp` must be a valid pointer to a `DspJit`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn dsp56300_raise_interrupt(
+    dsp: *mut DspJit,
+    vector: u32,
+    ipl: u32,
+    level: bool,
+) {
+    let dsp = unsafe { &mut *dsp };
+    dsp.state
+        .interrupts
+        .raise((vector / 2) as usize, ipl.min(3) as i8, level);
+}
+
+/// Withdraw the interrupt at byte offset `vector` and end its level.
+///
+/// # Safety
+/// `dsp` must be a valid pointer to a `DspJit`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn dsp56300_lower_interrupt(dsp: *mut DspJit, vector: u32) {
+    let dsp = unsafe { &mut *dsp };
+    dsp.state.interrupts.lower((vector / 2) as usize);
+}
+
+/// Whether the interrupt at byte offset `vector` is pending, that is raised
+/// and not yet taken.
+///
+/// # Safety
+/// `dsp` must be a valid pointer to a `DspJit`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn dsp56300_interrupt_pending(dsp: *const DspJit, vector: u32) -> bool {
+    let dsp = unsafe { &*dsp };
+    let i = (vector / 2) as usize;
+    i < 128 && dsp.state.interrupts.pending(i)
+}
