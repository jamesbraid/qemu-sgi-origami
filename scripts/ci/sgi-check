#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-3-Clause
"""Build QEMU for the SGI machines and run the SGI checks CI runs.

CI runs every mode inside the image built from
tests/docker/dockerfiles/debian-sgi.docker, with the checkout at /src.
A developer can run the same modes in that image against any build
directory, for example:

    scripts/ci/sgi-check --build build-ci build
    QEMU_TEST_SGI_ASSET_DIR=/path/to/assets \\
        scripts/ci/sgi-check --build build-ci smoke --base origin/sgi-origami

Each mode checks the Meson JUnit report of every test run it starts with
scripts/check-sgi-test-results.py, because Meson counts a skipped test as
a pass.
"""

import argparse
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path


SOURCE = Path(__file__).resolve().parents[2]
CHECKER = SOURCE / 'scripts/check-sgi-test-results.py'
OPTIONAL_QTEST_SKIPS = SOURCE / 'tests/qtest/mips64-qtest-optional-skips.txt'

CONFIGURE_ARGS = [
    '--target-list=mips64-softmmu', '--disable-docs', '--enable-tests',
    '--enable-hmp', '--enable-slirp', '--enable-debug-tcg', '--enable-opengl',
]

# The sgi_model contract suites. They need PyYAML and jsonschema, which
# pythondeps.toml lists as the sgi-model group, but no QEMU binary.
MODEL_SUITES = [
    'test_sgi_model_generator.py',
    'test_sgi_model_resolution.py',
    'test_sgi_model_export_contract.py',
    'test_sgi_model_validation_contract.py',
    'test_sgi_model_compiler_contract.py',
    'test_sgi_model_goldens.py',
    'test_sgi_model_resolution_contract.py',
]

# Migration cases start several QEMU processes per test file, so limit the
# number of concurrent files on the eight-CPU builders. On a loaded 32-thread
# host the whole set passed at four in 27 minutes against 45 at two, and
# timing assertions failed at eight.
QTEST_PROCESSES = 4

# Every pull request runs this whatever it changes.
ALWAYS_QTESTS = {'qtest-mips64/sn0-forward-progress-test'}


def run(cmd, **kwargs):
    print('+ ' + shlex.join(str(arg) for arg in cmd), flush=True)
    subprocess.run([str(arg) for arg in cmd], check=True, **kwargs)


def output(cmd, **kwargs):
    return subprocess.check_output([str(arg) for arg in cmd], text=True,
                                   **kwargs)


class Build:
    def __init__(self, path):
        self.path = path
        self.python = path / 'pyvenv/bin/python3'
        self.meson = path / 'pyvenv/bin/meson'

    def ninja(self, *targets):
        run(['ninja', '-C', self.path, *targets])

    def meson_test(self, logbase, args, expect, allow_skips=None,
                   processes=None):
        """Run one Meson test invocation and check its JUnit report."""
        cmd = [self.meson, 'test', '-C', self.path, '--setup', 'qemu:thorough',
               '--logbase', logbase, '--print-errorlogs']
        if processes:
            cmd += ['--num-processes', str(processes)]
        run(cmd + list(args))
        reports = sorted((self.path / 'meson-logs').glob(
            f'{logbase}*.junit.xml'))
        if len(reports) != 1:
            sys.exit(f'expected one JUnit report for {logbase}, '
                     f'found {len(reports)}')
        check = [sys.executable, CHECKER, '--junit', reports[0],
                 '--expect', expect]
        if allow_skips:
            check += ['--allow-skips-from', allow_skips]
        run(check)

    def list_meson_tests(self, dest, *selection):
        with open(dest, 'w', encoding='utf-8') as out:
            run([sys.executable, CHECKER, '--list-meson-tests', self.path,
                 *selection], stdout=out)

    def registered_tests(self):
        tests = json.loads(output([self.meson, 'introspect', '--tests',
                                   self.path]))
        return {item.get('name') for item in tests
                if isinstance(item, dict) and isinstance(item.get('name'), str)}


def build(args):
    path = args.build
    path.mkdir(parents=True, exist_ok=True)
    if not (path / 'build.ninja').exists():
        run([SOURCE / 'configure', *CONFIGURE_ARGS], cwd=path)
    # The image installs this group, so the check needs no network. Allow
    # PyPI only when asked, for hosts whose Python lacks it.
    ensure = [path / 'pyvenv/bin/python3',
              SOURCE / 'python/scripts/mkvenv.py', 'ensuregroup']
    if args.online:
        ensure.append('--online')
    run(ensure + [SOURCE / 'pythondeps.toml', 'sgi-model'])
    run(['ninja', '-C', path])


def model(args):
    python = args.python or sys.executable
    for suite in MODEL_SUITES:
        run([python, '-B', SOURCE / 'scripts/tests' / suite])


def select_qtests(build, base):
    """Choose the qtests a pull request runs from what it changed."""
    registered = build.registered_tests()
    all_mips64 = {name for name in registered
                  if name.startswith('qtest-mips64/')}
    selected = set(ALWAYS_QTESTS)
    full = False
    if base:
        paths = output(['git', '-C', SOURCE, 'diff', '--name-only', base,
                        'HEAD', '--', 'tests/qtest']).splitlines()
        for path in paths:
            target = 'qtest-mips64/' + Path(path).stem
            if (path.endswith('.c') and (SOURCE / path).is_file() and
                    target in registered):
                selected.add(target)
            else:
                full = True
    if full:
        selected = all_mips64
    selected &= registered
    if not selected:
        sys.exit('no required MIPS64 qtest targets are registered')
    return sorted(selected), full


def smoke(args):
    build = Build(args.build)
    build.ninja('tests/functional/mips64-linux_kernel.tstamp')

    qtests, _ = select_qtests(build, args.base)
    expected = build.path / 'expected-qtests.txt'
    expected.write_text('\n'.join(qtests) + '\n', encoding='utf-8')
    # Optional prerequisites do not depend on which binaries are selected.
    build.meson_test('smoke-qtest', qtests, expected,
                     allow_skips=OPTIONAL_QTEST_SKIPS,
                     processes=QTEST_PROCESSES)

    expected = build.path / 'expected-linux.txt'
    expected.write_text('LinuxKernel.test_one_cpu\n', encoding='utf-8')
    build.meson_test('smoke-linux',
                     ['--test-args', 'LinuxKernel.test_one_cpu',
                      'func-mips64-linux_kernel'], expected)

    expected = build.path / 'expected-unit.txt'
    build.list_meson_tests(expected, '--suite', 'qemu:sgi-unit')
    build.meson_test('smoke-unit', ['--suite', 'qemu:sgi-unit'], expected)


# Functional test classes whose every test_ method the full run requires.
FULL_FUNCTIONAL = [
    ('func-mips64-origin200_prom', 'full-prom',
     'test_origin200_prom', 'OriginPromMatrix'),
    ('func-mips64-linux_kernel', 'full-linux',
     'test_linux_kernel', 'LinuxKernel'),
    ('func-mips64-irix_miniroot', 'full-irix',
     'test_irix_miniroot', 'IrixMiniroot'),
]


def list_cases(args):
    """Print a functional test class's test methods, one per line."""
    module = __import__(args.module)
    test_class = getattr(module, args.test_class)
    cases = [f'{test_class.__name__}.{name}'
             for name in sorted(test_class.__dict__)
             if name.startswith('test_')]
    if not cases:
        sys.exit(f'no required test cases registered for '
                 f'{test_class.__name__}')
    print('\n'.join(cases))


def required_cases(build, module, test_class, dest):
    """Import the test class in the build's Python, as Meson would."""
    env = dict(os.environ, MESON_BUILD_ROOT=str(build.path),
               PYTHONPATH=':'.join(str(SOURCE / part) for part in (
                   'python', 'tests/functional', 'tests/functional/mips64')))
    with open(dest, 'w', encoding='utf-8') as out:
        run([build.python, __file__, 'list-cases', module, test_class],
            env=env, stdout=out)


def full(args):
    build = Build(args.build)
    build.ninja(*(f'tests/functional/mips64-{target[len("func-mips64-"):]}'
                  '.tstamp' for target, *_ in FULL_FUNCTIONAL))
    for target, logbase, module, test_class in FULL_FUNCTIONAL:
        required_cases(build, module, test_class,
                       build.path / f'{logbase}.expected')
    for target, logbase, *_ in FULL_FUNCTIONAL:
        build.meson_test(logbase, [target],
                         build.path / f'{logbase}.expected')

    expected = build.path / 'full-rom.expected'
    with open(expected, 'w', encoding='utf-8') as out:
        run([sys.executable, CHECKER, '--list-rom-identities',
             SOURCE / 'tests/functional/mips64/roms/suite',
             '--require-rom-target', build.path], stdout=out)
    build.meson_test('full-rom', ['func-mips64-sgi_roms'], expected)

    expected = build.path / 'full-unit.expected'
    build.list_meson_tests(expected, '--suite', 'qemu:sgi-unit')
    build.meson_test('full-unit', ['--suite', 'qemu:sgi-unit'], expected)

    run([build.meson, 'test', '-C', build.path, '--setup', 'qemu:thorough',
         '--logbase', 'full-qtest', '--num-processes', str(QTEST_PROCESSES),
         '--print-errorlogs', '--suite', 'qemu:qtest-mips64'])


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--build', type=Path, default=SOURCE / 'build-ci',
                        help='build directory (default: build-ci in the '
                             'source tree)')
    modes = parser.add_subparsers(dest='mode', required=True)

    mode = modes.add_parser('build', help='configure as CI does and build')
    mode.add_argument('--online', action='store_true',
                      help='let mkvenv fetch the sgi-model group from PyPI')
    mode.set_defaults(func=build)

    mode = modes.add_parser('model', help='run the sgi_model contract suites')
    mode.add_argument('--python', type=Path,
                      help='interpreter to run them with')
    mode.set_defaults(func=model)

    mode = modes.add_parser(
        'smoke', help='the pull-request checks: the qtests a change '
                      'selects, one Linux boot and the unit tests')
    mode.add_argument('--base', default=os.environ.get('PR_BASE_SHA'),
                      help='select qtests changed since this commit '
                           '(default: $PR_BASE_SHA; none selects only the '
                           'always-run set)')
    mode.set_defaults(func=smoke)

    mode = modes.add_parser(
        'full', help='the merge-queue checks: every qtest, boot and ROM')
    mode.set_defaults(func=full)

    mode = modes.add_parser('list-cases', help=argparse.SUPPRESS)
    mode.add_argument('module')
    mode.add_argument('test_class')
    mode.set_defaults(func=list_cases)

    args = parser.parse_args(argv)
    if hasattr(args, 'build'):
        args.build = args.build.resolve()
    args.func(args)


if __name__ == '__main__':
    main()
