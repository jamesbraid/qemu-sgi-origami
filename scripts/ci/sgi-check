def smoke(args):
    """The pull-request check: build, then only what the change edits.

    The generated-ROM functional tests are quick and always run. The boots
    and the ROM suite run in the full run, which the merge queue dispatches
    before every land, so they are not repeated here.
    """
    build = Build(args.build)
    script_suites(BUILD_SCRIPT_SUITES, build.python)
    build.ninja(*(f'tests/functional/mips64-{target[len("func-mips64-"):]}'
                  '.tstamp' for target, *_ in GENERATED_ROM_FUNCTIONAL))

    qtests = select_qtests(build, args.base)
    selected = build.path / 'selected-qtests.txt'
    selected.write_text('\n'.join(qtests) + '\n' if qtests else '',
                        encoding='utf-8')
    # Pull requests run the quick setup, which leaves out the slow suite
    # and the cases a qtest registers only under g_test_slow(). The
    # merge queue's full run keeps the thorough setup. Meson refuses a
    # named test its setup leaves out, and the report check refuses an
    # empty selection, so drop those tests here and say so.
    suites = build.registered_tests()
    quick = [test for test in qtests
             if not suites[test] & set(QUICK_EXCLUDED_SUITES)]
    if quick != qtests:
        print('left to the full run (slow or thorough): ' +
              ' '.join(sorted(set(qtests) - set(quick))), flush=True)
    kept, left = fit_budget(quick, read_durations(QTEST_DURATIONS))
    if left:
        print(f'left to the full run (over the {SMOKE_QTEST_BUDGET_S} s '
              'budget): ' + ' '.join(left), flush=True)
    if kept:
        names = build.path / 'quick-qtests.txt'
        names.write_text('\n'.join(kept) + '\n', encoding='utf-8')
        expected = build.path / 'expected-qtests.txt'
        build.list_meson_tests(expected, '--names-from', names)
        build.meson_test('smoke-qtest', kept, expected,
                         processes=QTEST_PROCESSES, setup='qemu:quick')
    else:
        print('no qtest source changed; the full run runs every qtest',
              flush=True)

    for target, logbase, module, test_class in GENERATED_ROM_FUNCTIONAL:
        expected = build.path / f'expected-{logbase}.txt'
        build.meson_test(f'smoke-{logbase}',
                         required_cases(build, module, test_class,
                                        expected) + [target],
                         expected)

    # sgi-unit includes the unit tests of the functional tests' lib_*.py
    # helpers.
    expected = build.path / 'expected-unit.txt'
    build.list_meson_tests(expected, '--suite', 'qemu:sgi-unit')
    build.meson_test('smoke-unit', ['--suite', 'qemu:sgi-unit'], expected)


