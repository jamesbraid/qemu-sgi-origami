"""Build QEMU for the SGI machines and run the SGI checks CI runs.

CI runs every mode inside the image built from
tests/docker/dockerfiles/debian-sgi.docker, with the checkout at /src.
A developer can run the same modes in that image against any build
directory, for example:

    scripts/ci/sgi-check --build build-ci build
    QEMU_TEST_SGI_ASSET_DIR=/path/to/assets \\
        scripts/ci/sgi-check --build build-ci smoke --base origin/sgi-origami

Each mode checks the Meson JUnit report of every test run it starts with
scripts/check-sgi-test-results.py, because Meson counts a skipped test as
a pass.
"""

import argparse
import json
import os
import re
import shlex
import statistics
import subprocess
import sys
from pathlib import Path


SOURCE = Path(__file__).resolve().parents[2]
CHECKER = SOURCE / 'scripts/check-sgi-test-results.py'
OPTIONAL_QTEST_SKIPS = SOURCE / 'tests/qtest/mips64-qtest-optional-skips.txt'
QTEST_DURATIONS = SOURCE / 'scripts/ci/qtest-durations.txt'

CONFIGURE_ARGS = [
    '--target-list=mips64-softmmu', '--disable-docs', '--enable-tests',
    '--enable-hmp', '--enable-slirp', '--enable-debug-tcg', '--enable-opengl',
    # The image's gdb, so gdbstub functional cases run rather than skip.
    '--gdb=/usr/bin/gdb-multiarch',
]

# The sgi_model contract suites. They need PyYAML and jsonschema, which
# pythondeps.toml lists as the sgi-model group, but no QEMU binary.
MODEL_SUITES = [
    'scripts/tests/test_sgi_model_generator.py',
    'scripts/tests/test_sgi_model_resolution.py',
    'scripts/tests/test_sgi_model_export_contract.py',
    'scripts/tests/test_sgi_model_validation_contract.py',
    'scripts/tests/test_sgi_model_compiler_contract.py',
    'scripts/tests/test_sgi_model_goldens.py',
    'scripts/tests/test_sgi_model_resolution_contract.py',
]

# The other script tests that need neither a build nor network access.
SCRIPT_SUITES = MODEL_SUITES + [
    'scripts/tests/test_sgi_model_ip30.py',
    'scripts/tests/test_check_sgi_test_results.py',
    'scripts/tests/test_archive_source.py',
    'scripts/ci/test_sgi_check.py',
    'scripts/test_sanitizer_workflow.py',
]

# Script tests that import the functional test framework, which needs
# pycotap and qemu.qmp from the build tree's pyvenv.
BUILD_SCRIPT_SUITES = [
    'scripts/test_provision_sgi_test_assets.py',
]

# Migration cases start several QEMU processes per test file, so limit the
# number of concurrent files on the eight-CPU builders. On a loaded 32-thread
# host the whole set passed at four in 27 minutes against 45 at two, and
# timing assertions failed at eight.
QTEST_PROCESSES = 4

# Every pull request runs this whatever it changes.
ALWAYS_QTESTS = {'qtest-mips64/sn0-forward-progress-test'}

# The suites the top-level meson.build's quick setup leaves out.
QUICK_EXCLUDED_SUITES = ('slow', 'thorough')


def run(cmd, **kwargs):
    print('+ ' + shlex.join(str(arg) for arg in cmd), flush=True)
    subprocess.run([str(arg) for arg in cmd], check=True, **kwargs)


def output(cmd, **kwargs):
    return subprocess.check_output([str(arg) for arg in cmd], text=True,
                                   **kwargs)


class Build:
    def __init__(self, path):
        self.path = path
        self.python = path / 'pyvenv/bin/python3'
        self.meson = path / 'pyvenv/bin/meson'

    def ninja(self, *targets):
        run(['ninja', '-C', self.path, *targets])

    def meson_test(self, logbase, args, expect, allow_skips=None,
                   processes=None, setup='qemu:thorough'):
        """Run one Meson test invocation and check its JUnit report."""
        cmd = [self.meson, 'test', '-C', self.path, '--setup', setup,
               '--logbase', logbase, '--print-errorlogs']
        if processes:
            cmd += ['--num-processes', str(processes)]
        run(cmd + list(args))
        reports = sorted((self.path / 'meson-logs').glob(
            f'{logbase}-*.junit.xml'))
        if len(reports) != 1:
            sys.exit(f'expected one JUnit report for {logbase}, '
                     f'found {len(reports)}')
        check = [sys.executable, CHECKER, '--junit', reports[0],
                 '--expect', expect]
        if allow_skips:
            check += ['--allow-skips-from', allow_skips]
        run(check)

    def list_meson_tests(self, dest, *selection):
        with open(dest, 'w', encoding='utf-8') as out:
            run([sys.executable, CHECKER, '--list-meson-tests', self.path,
                 *selection], stdout=out)

    def registered_tests(self):
        tests = json.loads(output([self.meson, 'introspect', '--tests',
                                   self.path]))
        return {item.get('name') for item in tests
                if isinstance(item, dict) and isinstance(item.get('name'), str)}


def build(args):
    path = args.build
    path.mkdir(parents=True, exist_ok=True)
    if not (path / 'build.ninja').exists():
        run([SOURCE / 'configure', *CONFIGURE_ARGS], cwd=path)
    # The image installs this group, so the check needs no network. Allow
    # PyPI only when asked, for hosts whose Python lacks it.
    ensure = [path / 'pyvenv/bin/python3',
              SOURCE / 'python/scripts/mkvenv.py', 'ensuregroup']
    if args.online:
        ensure.append('--online')
    run(ensure + [SOURCE / 'pythondeps.toml', 'sgi-model'])
    run(['ninja', '-C', path])


def rom_suite(build, logbase):
    """Run the ROMs built from tests/functional/mips64/roms/suite."""
    expected = build.path / f'{logbase}.expected'
    with open(expected, 'w', encoding='utf-8') as out:
        run([sys.executable, CHECKER, '--list-rom-identities',
             SOURCE / 'tests/functional/mips64/roms/suite',
             '--require-rom-target', build.path], stdout=out)
    build.meson_test(logbase, ['func-mips64-sgi_roms'], expected)


def script_suites(suites, python):
    for suite in suites:
        run([python or sys.executable, '-B', SOURCE / suite])


def model(args):
    script_suites(MODEL_SUITES, args.python)


def scripts(args):
    script_suites(SCRIPT_SUITES, args.python)


QTEST_MESON = 'tests/qtest/meson.build'

# The per-test table in tests/qtest/meson.build. Changing an entry changes
# only how that one test is run.
QTEST_TABLES = ('slow_qtests',)
QTEST_TABLE = re.compile(
    r'^(?P<name>' + '|'.join(QTEST_TABLES) + r')\s*=\s*\{\n(?P<body>.*?)^\}\n',
    re.M | re.S)
QTEST_ENTRY = re.compile(
    r"\s*'(?P<test>[^']+)'\s*:\s*(?P<value>[^,#\s][^,#]*?)\s*,\s*(#.*)?")


def qtest_tables(text):
    """Split meson.build into its per-test tables and everything else.

    Return None for the tables when a table line is neither blank, a
    comment nor exactly one entry, so an edit the parser cannot read
    counts as an edit outside the tables.
    """
    tables = {}
    for match in QTEST_TABLE.finditer(text):
        entries = {}
        for line in match['body'].splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            entry = QTEST_ENTRY.fullmatch(line)
            if not entry:
                return None, text
            entries[entry['test']] = entry['value']
        tables[match['name']] = entries
    return tables, QTEST_TABLE.sub('', text)


def changed_table_tests(old_text, new_text):
    """Name the tests whose table entries differ, or None for other edits."""
    old_tables, old_rest = qtest_tables(old_text)
    new_tables, new_rest = qtest_tables(new_text)
    if (old_tables is None or new_tables is None or old_rest != new_rest or
            set(old_tables) != set(QTEST_TABLES) or
            set(new_tables) != set(QTEST_TABLES)):
        return None
    changed = set()
    for table in QTEST_TABLES:
        old, new = old_tables[table], new_tables[table]
        changed |= {test for test in old.keys() | new.keys()
                    if old.get(test) != new.get(test)}
    return changed


def merge_base(base):
    try:
        return output(['git', '-C', SOURCE, 'merge-base', base, 'HEAD'],
                      stderr=subprocess.DEVNULL).strip()
    except subprocess.CalledProcessError:
        return None


def select_qtests(build, base):
    """Choose the qtests a pull request runs from what it changed.

    Compare against the merge base, so commits that reached the base branch
    after the pull request forked do not read as the pull request's changes.
    A changed test source selects that test, and a change confined to
    meson.build's per-test tables selects the tests whose entries changed.
    Any other change under tests/qtest, or a missing merge base, selects
    every MIPS64 qtest.
    """
    registered = build.registered_tests()
    all_mips64 = {name for name in registered
                  if name.startswith('qtest-mips64/')}
    selected = set(ALWAYS_QTESTS)
    full = False
    fork = merge_base(base) if base else None
    if base and not fork:
        print(f'no merge base between {base} and HEAD; '
              'selecting every MIPS64 qtest', flush=True)
        full = True
    if fork:
        paths = output(['git', '-C', SOURCE, 'diff', '--name-only', fork,
                        'HEAD', '--', 'tests/qtest']).splitlines()
        for path in paths:
            target = 'qtest-mips64/' + Path(path).stem
            if (path.endswith('.c') and (SOURCE / path).is_file() and
                    target in registered):
                selected.add(target)
                continue
            if path == QTEST_MESON and (SOURCE / path).is_file():
                tests = changed_table_tests(
                    output(['git', '-C', SOURCE, 'show',
                            f'{fork}:{QTEST_MESON}']),
                    (SOURCE / path).read_text(encoding='utf-8'))
                if tests is not None:
                    selected |= {'qtest-mips64/' + test for test in tests}
                    continue
            full = True
    if full:
        selected = all_mips64
    selected &= registered
    if not selected:
        sys.exit('no required MIPS64 qtest targets are registered')
    return sorted(selected), full


def smoke(args):
    build = Build(args.build)
    script_suites(BUILD_SCRIPT_SUITES, build.python)
    build.ninja('tests/functional/mips64-linux_kernel.tstamp',
                'tests/functional/mips64-sn0_smp.tstamp')

    # Pull requests run the quick setup, which leaves out the slow suite
    # and the cases a qtest registers only under g_test_slow(). The
    # merge queue's full run keeps the thorough setup.
    qtests, _ = select_qtests(build, args.base)
    selected = build.path / 'selected-qtests.txt'
    selected.write_text('\n'.join(qtests) + '\n', encoding='utf-8')
    expected = build.path / 'expected-qtests.txt'
    build.list_meson_tests(expected, '--names-from', selected,
                           *(f'--exclude-suite={suite}'
                             for suite in QUICK_EXCLUDED_SUITES))
    # Name only the tests the setup keeps: Meson refuses a named test its
    # setup leaves out as matching no test. Optional prerequisites do not
    # depend on which binaries are selected.
    build.meson_test('smoke-qtest',
                     expected.read_text(encoding='utf-8').split(), expected,
                     allow_skips=OPTIONAL_QTEST_SKIPS,
                     processes=QTEST_PROCESSES, setup='qemu:quick')

    expected = build.path / 'expected-linux.txt'
    expected.write_text('LinuxKernel.test_one_cpu\n', encoding='utf-8')
    build.meson_test('smoke-linux',
                     ['--test-args', 'LinuxKernel.test_one_cpu',
                      'func-mips64-linux_kernel'], expected)

    # The SMP machine cases build their own firmware and need no guest
    # assets, so every pull request runs all of them.
    expected = build.path / 'expected-smp.txt'
    build.meson_test('smoke-smp',
                     required_cases(build, 'test_sn0_smp', 'SN0SMPMachine',
                                    expected) + ['func-mips64-sn0_smp'],
                     expected)

    # sgi-unit includes the unit tests of the functional tests' lib_*.py
    # helpers.
    expected = build.path / 'expected-unit.txt'
    build.list_meson_tests(expected, '--suite', 'qemu:sgi-unit')
    build.meson_test('smoke-unit', ['--suite', 'qemu:sgi-unit'], expected)

    rom_suite(build, 'smoke-rom')


# The functional tests the full run requires: the Meson test, its log
# base, the module and class whose test_ methods it lists, and the cases to
# run, or None for every case. The two- and four-CPU Linux boots took
# about 14 of the 18 minutes of the Linux test in the full run, so they run
# only in the nightly's Monday, Wednesday and Friday matrix workload.
FULL_FUNCTIONAL = [
    ('func-mips64-origin200_prom', 'full-prom',
     'test_origin200_prom', 'OriginPromMatrix', None),
    ('func-mips64-linux_kernel', 'full-linux',
     'test_linux_kernel', 'LinuxKernel', ['test_one_cpu']),
    ('func-mips64-irix_miniroot', 'full-irix',
     'test_irix_miniroot', 'IrixMiniroot', None),
    ('func-mips64-sn0_smp', 'full-smp',
     'test_sn0_smp', 'SN0SMPMachine', None),
]


def list_cases(args):
    """Print a functional test class's test methods, one per line."""
    module = __import__(args.module)
    test_class = getattr(module, args.test_class)
    cases = [f'{test_class.__name__}.{name}'
             for name in sorted(test_class.__dict__)
             if name.startswith('test_')]
    if not cases:
        sys.exit(f'no required test cases registered for '
                 f'{test_class.__name__}')
    print('\n'.join(cases))


def required_cases(build, module, test_class, dest, selected=None):
    """Import the test class in the build's Python, as Meson would.

    Write every case of the class to dest, or only the selected ones,
    which must all exist, and return the Meson arguments that run them.
    """
    env = dict(os.environ, MESON_BUILD_ROOT=str(build.path),
               PYTHONPATH=':'.join(str(SOURCE / part) for part in (
                   'python', 'tests/functional', 'tests/functional/mips64')))
    cases = output([build.python, __file__, 'list-cases', module, test_class],
                   env=env).split()
    if selected is None:
        dest.write_text('\n'.join(cases) + '\n', encoding='utf-8')
        return []
    selected = [f'{test_class}.{name}' for name in selected]
    missing = sorted(set(selected) - set(cases))
    if missing:
        sys.exit(f'{test_class} has no case {", ".join(missing)}')
    dest.write_text('\n'.join(selected) + '\n', encoding='utf-8')
    return ['--test-args', ' '.join(selected)]


def full_functional(build):
    """Run the boots, the ROM suite and the unit tests."""
    build.ninja(*(f'tests/functional/mips64-{target[len("func-mips64-"):]}'
                  '.tstamp' for target, *_ in FULL_FUNCTIONAL))
    runs = []
    for target, logbase, module, test_class, selected in FULL_FUNCTIONAL:
        expected = build.path / f'{logbase}.expected'
        runs.append((logbase, required_cases(build, module, test_class,
                                             expected, selected) + [target],
                     expected))
    for logbase, meson_args, expected in runs:
        build.meson_test(logbase, meson_args, expected)

    rom_suite(build, 'full-rom')

    expected = build.path / 'full-unit.expected'
    build.list_meson_tests(expected, '--suite', 'qemu:sgi-unit')
    build.meson_test('full-unit', ['--suite', 'qemu:sgi-unit'], expected)


def read_durations(path):
    durations = {}
    for line in path.read_text(encoding='utf-8').splitlines():
        if line.strip() and not line.lstrip().startswith('#'):
            name, seconds = line.split()
            durations[name] = float(seconds)
    return durations


def qtest_shards(tests, durations, count):
    """Split tests into count lists of roughly equal measured duration.

    Take the longest test first and give each to the least-loaded shard,
    breaking ties by name and shard number, so every job that computes
    the split from the same tests gets the same answer. A test with no
    measurement counts as the median of those that have one.
    """
    known = [durations[test] for test in tests if test in durations]
    default = statistics.median(known) if known else 1.0
    weight = {test: durations.get(test, default) for test in tests}
    shards = [[] for _ in range(count)]
    loads = [0.0] * count
    for test in sorted(tests, key=lambda test: (-weight[test], test)):
        shard = min(range(count), key=lambda k: (loads[k], k))
        shards[shard].append(test)
        loads[shard] += weight[test]
    return [sorted(shard) for shard in shards], loads


def full_qtest(build, index, count):
    """Run one of count roughly equal shares of the MIPS64 qtests."""
    every = build.path / 'full-qtest.all'
    build.list_meson_tests(every, '--suite', 'qemu:qtest-mips64')
    tests = every.read_text(encoding='utf-8').split()
    shards, loads = qtest_shards(tests, read_durations(QTEST_DURATIONS),
                                 count)
    share = shards[index - 1]
    if not share:
        sys.exit(f'qtest shard {index} of {count} has no tests')
    print(f'qtest shard {index} of {count}: {len(share)} of {len(tests)} '
          f'tests, about {loads[index - 1] / 60:.0f} of '
          f'{sum(loads) / 60:.0f} test-minutes', flush=True)
    logbase = f'full-qtest-{index}-of-{count}'
    expected = build.path / f'{logbase}.expected'
    expected.write_text('\n'.join(share) + '\n', encoding='utf-8')
    build.meson_test(logbase, share, expected,
                     allow_skips=OPTIONAL_QTEST_SKIPS,
                     processes=QTEST_PROCESSES)


FULL_PART = re.compile(r'functional|qtest-(?P<index>[1-9]\d*)-of-'
                       r'(?P<count>[1-9]\d*)')


def full_part(text):
    match = FULL_PART.fullmatch(text)
    if not match or (match['index'] and
                     int(match['index']) > int(match['count'])):
        raise argparse.ArgumentTypeError(
            f'{text!r} is not functional or qtest-K-of-N with K <= N')
    return text


def full(args):
    build = Build(args.build)
    if args.part in (None, 'functional'):
        full_functional(build)
    if args.part is None:
        full_qtest(build, 1, 1)
    elif args.part != 'functional':
        match = FULL_PART.fullmatch(args.part)
        full_qtest(build, int(match['index']), int(match['count']))


def needs_passed(args):
    """Fail unless every named job in $NEEDS, toJSON(needs), succeeded.

    A required check must not pass because a job it depends on was
    skipped or cancelled, so anything but success fails, including a
    job missing from $NEEDS.
    """
    try:
        needs = json.loads(os.environ.get('NEEDS') or '{}')
    except json.JSONDecodeError as exc:
        sys.exit(f'$NEEDS is not JSON: {exc}')
    if not isinstance(needs, dict):
        sys.exit('$NEEDS is not a JSON object')
    failed = []
    for job in args.jobs:
        result = needs.get(job)
        result = (result.get('result') if isinstance(result, dict)
                  else None) or 'missing'
        print(f'{job}: {result}')
        if result != 'success':
            failed.append(f'{job} ({result})')
    if failed:
        sys.exit('jobs that did not succeed: ' + ', '.join(failed))


def failing_step_reported(args):
    """Say whether this run already published its failing step.

    Read the commit's statuses, as the forge's API lists them, on stdin.
    Exit 0 if one is a ci/failing-step status pointing at this run, 1 if
    none is, and 2 if the list cannot be read.
    """
    try:
        statuses = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(f'cannot read the commit statuses: {exc}', file=sys.stderr)
        sys.exit(2)
    if not isinstance(statuses, list):
        print('the commit statuses are not a list', file=sys.stderr)
        sys.exit(2)
    for status in statuses:
        if (isinstance(status, dict) and
                status.get('context') == 'ci/failing-step' and
                status.get('target_url') == args.run_url):
            print(f'this run already published: {status.get("description")}')
            sys.exit(0)
    sys.exit(1)


DURATIONS_HEADER = """\
# Seconds each MIPS64 qtest took in a full run, which scripts/ci/sgi-check
# uses to split the qtests evenly between the full run's jobs. Measured in
# actions run 42473 on an 8-CPU builder at four processes, 2026-10-05.
# Refresh from a later full run's Meson test logs with
#   scripts/ci/sgi-check qtest-durations build-ci/meson-logs/full-qtest-*.json
# A test missing from this list counts as the median of the others.
"""


def qtest_durations(args):
    """Print a durations list from Meson's JSON test logs."""
    durations = {}
    for log in args.logs:
        for line in log.read_text(encoding='utf-8').splitlines():
            if not line.strip():
                continue
            entry = json.loads(line)
            if entry.get('name', '').startswith('qtest-mips64/'):
                durations[entry['name']] = entry['duration']
    if not durations:
        sys.exit('no MIPS64 qtest durations in those logs')
    sys.stdout.write(DURATIONS_HEADER + ''.join(
        f'{name} {seconds:.0f}\n' for name, seconds in sorted(
            durations.items())))


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--build', type=Path, default=SOURCE / 'build-ci',
                        help='build directory (default: build-ci in the '
                             'source tree)')
    modes = parser.add_subparsers(dest='mode', required=True)

    mode = modes.add_parser('build', help='configure as CI does and build')
    mode.add_argument('--online', action='store_true',
                      help='let mkvenv fetch the sgi-model group from PyPI')
    mode.set_defaults(func=build)

    mode = modes.add_parser('model', help='run the sgi_model contract suites')
    mode.add_argument('--python', type=Path,
                      help='interpreter to run them with')
    mode.set_defaults(func=model)

    mode = modes.add_parser(
        'scripts', help='run the script tests that need no build, the '
                        'model suites among them')
    mode.add_argument('--python', type=Path,
                      help='interpreter to run them with')
    mode.set_defaults(func=scripts)

    mode = modes.add_parser(
        'smoke', help='the pull-request checks: the script tests that '
                      'need a build, the qtests a change selects in the '
                      'quick setup, one Linux boot, the unit tests and the '
                      'ROM suite')
    mode.add_argument('--base', default=os.environ.get('PR_BASE_SHA'),
                      help='select qtests changed since the merge base '
                           'with this commit (default: $PR_BASE_SHA; none '
                           'selects only the always-run set)')
    mode.set_defaults(func=smoke)

    mode = modes.add_parser(
        'full', help='the merge-queue checks: every qtest in the '
                     'thorough setup, the PROM, '
                     'one-CPU Linux and IRIX boots, and every ROM')
    mode.add_argument('--part', type=full_part,
                      help='run one part, as each full-run job does: '
                           'functional (the boots, ROMs and unit tests) '
                           'or qtest-K-of-N (share K of the qtests split '
                           'N ways by measured duration); default all')
    mode.set_defaults(func=full)

    mode = modes.add_parser(
        'needs-passed', help='fail unless each named job in $NEEDS, the '
                             "workflow's toJSON(needs), succeeded")
    mode.add_argument('jobs', nargs='+')
    mode.set_defaults(func=needs_passed)

    mode = modes.add_parser(
        'failing-step-reported',
        help='exit 0 if the statuses on stdin hold a ci/failing-step '
             'status for this run, 1 if not, 2 if they cannot be read')
    mode.add_argument('run_url')
    mode.set_defaults(func=failing_step_reported)

    mode = modes.add_parser(
        'qtest-durations', help='print a new scripts/ci/qtest-durations.txt '
                                "from Meson's JSON test logs")
    mode.add_argument('logs', nargs='+', type=Path)
    mode.set_defaults(func=qtest_durations)

    mode = modes.add_parser('list-cases', help=argparse.SUPPRESS)
    mode.add_argument('module')
    mode.add_argument('test_class')
    mode.set_defaults(func=list_cases)

    args = parser.parse_args(argv)
    if hasattr(args, 'build'):
        args.build = args.build.resolve()
    args.func(args)


if __name__ == '__main__':
    main()
