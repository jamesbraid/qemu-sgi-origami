def run(cmd, **kwargs):
    print('+ ' + shlex.join(str(arg) for arg in cmd), flush=True)
    subprocess.run([str(arg) for arg in cmd], check=True, **kwargs)


def output(cmd, **kwargs):
    return subprocess.check_output([str(arg) for arg in cmd], text=True,
                                   **kwargs)


def run_concurrently(commands, workers, logdir):
    """Run (label, command) pairs, at most workers at a time.

    Each command's output goes to a file in logdir and is printed once it
    finishes, whole, so concurrent output does not interleave. Start the
    commands in the order given, so list the longest first. Return each
    label's exit status.
    """
    lock = threading.Lock()

    def one(label, cmd):
        console = Path(logdir) / f'{label}.console'
        print(f'start {label}: ' + shlex.join(str(a) for a in cmd),
              flush=True)
        began = time.monotonic()
        with open(console, 'w', encoding='utf-8') as out:
            code = subprocess.run([str(a) for a in cmd], stdout=out,
                                  stderr=subprocess.STDOUT).returncode
        print(f'finish {label}: exit {code} after '
              f'{time.monotonic() - began:.0f} s', flush=True)
        text = console.read_text(encoding='utf-8', errors='replace')
        with lock:
            print(text, end='', flush=True)
        return code

    with concurrent.futures.ThreadPoolExecutor(max_workers=workers) as pool:
        futures = {label: pool.submit(one, label, cmd)
                   for label, cmd in commands}
        return {label: future.result() for label, future in futures.items()}


class Build:
    def __init__(self, path):
        self.path = path
        self.python = path / 'pyvenv/bin/python3'
        self.meson = path / 'pyvenv/bin/meson'

    def ninja(self, *targets):
        run(['ninja', '-C', self.path, *targets])

    def meson_command(self, logbase, args, processes=None,
                      setup='qemu:thorough', rebuild=True):
        cmd = [self.meson, 'test', '-C', self.path, '--setup', setup,
               '--logbase', logbase, '--print-errorlogs']
        if processes:
            cmd += ['--num-processes', str(processes)]
        if not rebuild:
            cmd.append('--no-rebuild')
        return cmd + [str(arg) for arg in args]

    def check_report(self, logbase, expect):
        """Check the JUnit report of a finished Meson test invocation."""
        reports = sorted((self.path / 'meson-logs').glob(
            f'{logbase}-*.junit.xml'))
        if len(reports) != 1:
            sys.exit(f'expected one JUnit report for {logbase}, '
                     f'found {len(reports)}')
        run([sys.executable, CHECKER, '--junit', reports[0],
             '--expect', expect])

    def meson_test(self, logbase, args, expect, processes=None,
                   setup='qemu:thorough'):
        """Run one Meson test invocation and check its JUnit report."""
        run(self.meson_command(logbase, args, processes, setup))
        self.check_report(logbase, expect)

    def test_prerequisites(self, names=(), suites=()):
        """Name the build outputs the selected tests depend on.

        Meson test builds them itself, but two invocations doing that in
        one build directory at once would run ninja twice at once.
        """
        tests = json.loads(output([self.meson, 'introspect', '--tests',
                                   self.path]))
        targets = json.loads(output([self.meson, 'introspect', '--targets',
                                     self.path]))
        files = {target['id']: target['filename'] for target in targets}
        wanted = set()
        for test in tests:
            suites_of_test = {entry.split(':', 1)[-1]
                              for entry in test['suite']}
            if test['name'] in names or suites_of_test & set(suites):
                wanted.update(test.get('depends', []))
        return sorted({os.path.relpath(name, self.path)
                       for target in wanted for name in files[target]})

    def meson_tests_concurrently(self, jobs, workers, names=(), suites=()):
        """Run Meson test invocations at once, then check every report.

        Each job is (logbase, meson args, expected cases file). Build
        everything the jobs depend on first, in one ninja run, then start
        the jobs without a rebuild. Every job's report is checked even when
        another failed, so one run shows every failure.
        """
        prerequisites = self.test_prerequisites(names, suites)
        if prerequisites:
            self.ninja(*prerequisites)
        commands = [(logbase, self.meson_command(logbase, args,
                                                 rebuild=False))
                    for logbase, args, _ in jobs]
        codes = run_concurrently(commands, workers, self.path)
        failed = [logbase for logbase, code in codes.items() if code]
        for logbase, _, expect in jobs:
            try:
                self.check_report(logbase, expect)
            except (SystemExit, subprocess.CalledProcessError) as exc:
                print(f'{logbase}: report check failed: {exc}', flush=True)
                if logbase not in failed:
                    failed.append(logbase)
        if failed:
            sys.exit('failed: ' + ', '.join(sorted(failed)))

    def list_meson_tests(self, dest, *selection):
        with open(dest, 'w', encoding='utf-8') as out:
            run([sys.executable, CHECKER, '--list-meson-tests', self.path,
                 *selection], stdout=out)

    def registered_tests(self):
        """Map each registered Meson test's name to its suite labels."""
        tests = json.loads(output([self.meson, 'introspect', '--tests',
                                   self.path]))
        return {item['name']: {suite.split(':', 1)[-1]
                               for suite in item.get('suite', [])
                               if isinstance(suite, str)}
                for item in tests
                if isinstance(item, dict) and isinstance(item.get('name'), str)}


def build(args):
    path = args.build
    path.mkdir(parents=True, exist_ok=True)
    if not (path / 'build.ninja').exists():
        run([SOURCE / 'configure', *CONFIGURE_ARGS], cwd=path)
    # The image installs this group, so the check needs no network. Allow
    # PyPI only when asked, for hosts whose Python lacks it.
    ensure = [path / 'pyvenv/bin/python3',
              SOURCE / 'python/scripts/mkvenv.py', 'ensuregroup']
    if args.online:
        ensure.append('--online')
    run(ensure + [SOURCE / 'pythondeps.toml', 'sgi-model'])
    run(['ninja', '-C', path])


def rom_expected(build, logbase):
    """Write the ROM identities the suite must run, and return the file."""
    expected = build.path / f'{logbase}.expected'
    with open(expected, 'w', encoding='utf-8') as out:
        run([sys.executable, CHECKER, '--list-rom-identities',
             SOURCE / 'tests/functional/mips64/roms/suite',
             '--require-rom-target', build.path], stdout=out)
    return expected


def rom_suite(build, logbase):
    """Run the ROMs built from tests/functional/mips64/roms/suite."""
    build.meson_test(logbase, ['func-mips64-sgi_roms'],
                     rom_expected(build, logbase))


