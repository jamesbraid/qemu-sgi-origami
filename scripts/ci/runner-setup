#!/bin/bash
# The Forgejo jobs share a Docker daemon. Pass its workspace volume to
# sibling containers instead of a path inside the job container. The other
# modes are the job-container steps every SGI build job repeats.
set -eu

# Remove child containers whose job container has gone. A job killed
# outright never runs its own cleanup, and its child would otherwise hold
# the daemon until the child's deadline. List the children before the
# running containers: a child exists only once its parent was running, so
# a parent still running is certain to be in the later list.
reap_orphans() {
  local children running id parent

  if ! children=$(docker ps -a --filter label=ci.parent \
                  --format '{{.ID}} {{.Label "ci.parent"}}') ||
     ! running=$(docker ps --no-trunc --filter status=running \
                 --format '{{.ID}}'); then
    echo 'Could not list containers; leaving child containers alone.' >&2
    return 0
  fi
  while read -r id parent; do
    [ -n "$id" ] || continue
    if [ -n "$parent" ] && printf '%s\n' "$running" | grep -qxF "$parent"; then
      continue
    fi
    echo "removing child container $id of finished job ${parent:-unknown}"
    docker rm -f "$id" >/dev/null || true
  done <<< "$children"
}

case "${1-}" in
  docker)
    # Install Docker only if absent and fail before build steps if its
    # daemon cannot be reached.
    command -v docker >/dev/null || {
      apt-get update -qq && apt-get install -y -qq --no-install-recommends docker.io
    }
    if ! version=$(docker version --format '{{.Server.Version}}'); then
      echo "The docker daemon is not reachable from this job. Every step"
      echo "below drives it, so they would fail further along and for"
      echo "reasons that do not name this as the cause."
      exit 1
    fi
    echo "  daemon $version"
    ;;
  describe)
    # Record host load and container state for resource-failure diagnosis.
    echo "runner VM: $(docker info --format '{{.Name}}' 2>/dev/null || echo unknown)"
    # Sample CPU steal over one second to record the current rate.
    s1=$(awk '/^cpu /{print $9}' /proc/stat); sleep 1
    s2=$(awk '/^cpu /{print $9}' /proc/stat)
    echo "cpus: $(nproc)  load at start: $(cut -d' ' -f1-3 /proc/loadavg)  steal: $((s2-s1)) ticks/s"
    # Include names and ages so concurrent job containers are visible.
    echo "containers now on this VM: $(docker ps -q 2>/dev/null | wc -l)"
    docker ps --format '{{.Names}}	{{.RunningFor}}	{{.Image}}' 2>/dev/null | head -12
    grep -E 'MemTotal|MemAvailable' /proc/meminfo | tr -s ' '
    ;;
  image)
    : "${GITHUB_ENV:?GITHUB_ENV is required}"
    image_id=$(docker build -q -f tests/docker/dockerfiles/debian-sgi.docker \
        tests/docker/dockerfiles)
    test -n "$image_id"
    echo "IMAGE_ID=$image_id" >> "$GITHUB_ENV"
    ;;
  assets)
    # Fetch the guest assets the SGI checks boot into sgi-assets/ and verify
    # each against its recorded SHA-256 before using it.
    set +x
    : "${CI_ASSET_BASE_URL:?CI_ASSET_BASE_URL is required}"
    : "${ASSET_TOKEN:?ASSET_TOKEN is required}"
    download_asset() {
      path=$1 package=$2 sha=$3 name=$4
      mkdir -p "$(dirname "$path")"
      temp="${path}.tmp.$$"
      curl -fsS -H "Authorization: token ${ASSET_TOKEN}" \
        -o "$temp" \
        "${CI_ASSET_BASE_URL%/}/${package}/${sha}/${name}"
      printf '%s  %s\n' "$sha" "$temp" | sha256sum -c --status -
      mv "$temp" "$path"
    }
    download_asset sgi-assets/firmware/6.5.30/ip27prom.payload.bin \
      firmware-6.5.30 c2c69bf33c375b43ec7ac511fab41ddf595be1b6838ae717e58a9a1273437fdd ip27prom.payload.bin
    download_asset sgi-assets/linux-ip27/vmlinux \
      linux-ip27 d095c9033e2f8aeca0a75adbbdc1d0acdf764230999b63eb6261574d65c77bd4 vmlinux
    download_asset sgi-assets/boot/6.5.30/unix.IP27 \
      boot-6.5.30 cbdb02ea5d334ecac949a6524a363e6c945f94baf438d41e8d9248eda0377bdf unix.IP27
    ;;
  report-failure)
    # Report the step name when a setup failure occurs before a check does.
    : "${CI_STEP:?CI_STEP is required}"
    : "${FORGE_API:?FORGE_API is required}"
    : "${FORGE_TOKEN:?FORGE_TOKEN is required}"
    : "${RUN_URL:?RUN_URL is required}"
    : "${COMMIT_SHA:?COMMIT_SHA is required}"
    step=$(cat "$CI_STEP" 2>/dev/null || echo "before any step ran")
    echo "failing step: $step"
    # The full run's parts each publish their own failing step. With
    # ONLY_IF_UNREPORTED=1 the job that collects them publishes only when
    # none did, so it never replaces a part's more specific message. If
    # the statuses cannot be read, publish nothing rather than risk that.
    if [ "${ONLY_IF_UNREPORTED-}" = 1 ]; then
      reported=0
      curl -sS -H "Authorization: token $FORGE_TOKEN" \
          "$FORGE_API/commits/$COMMIT_SHA/statuses?sort=recentupdate&limit=50" \
          | python3 scripts/ci/sgi-check failing-step-reported "$RUN_URL" \
          || reported=$?
      case "$reported" in
        0) exit 0 ;;
        1) ;;
        *) echo "could not read this commit's statuses; not publishing"
           exit 0 ;;
      esac
    fi
    curl -sS -X POST \
      -H "Authorization: token $FORGE_TOKEN" \
      -H "Content-Type: application/json" \
      -d "{\"state\":\"failure\",\"context\":\"ci/failing-step\",\"description\":\"$step\",\"target_url\":\"$RUN_URL\"}" \
      "$FORGE_API/statuses/$COMMIT_SHA" \
      >/dev/null || echo "could not publish the failing step; the log is the only copy"
    ;;
  nudge-queue)
    # Notify the queue after a successful build; its schedule is the
    # fallback. An already-waiting run will see this result. If lookup
    # fails, dispatch anyway; a duplicate notification is safer than a
    # stalled queue.
    : "${FORGE_API:?FORGE_API is required}"
    : "${FORGE_TOKEN:?FORGE_TOKEN is required}"
    waiting=$(curl -sS -H "Authorization: token $FORGE_TOKEN" \
        "$FORGE_API/actions/runs?workflow_id=merge-queue.yml&status=waiting&limit=1" \
        | grep -o '"total_count":[0-9]*' | cut -d: -f2)
    if [ "${waiting:-0}" -gt 0 ] 2>/dev/null; then
      echo "a queue run is already waiting and will see this green; not dispatching another"
    else
      curl -sS -X POST \
        -H "Authorization: token $FORGE_TOKEN" \
        -H "Content-Type: application/json" \
        -d '{"ref":"sgi-origami"}' \
        "$FORGE_API/actions/workflows/merge-queue.yml/dispatches" \
        && echo "queue nudged" \
        || echo "nudge failed; the scheduled backstop will advance the queue instead"
    fi
    ;;
  fetch-base)
    # The checkout is one commit deep. Fetch the pull request's base and
    # deepen both histories until they meet, so smoke can diff against the
    # merge base. Without one, smoke selects every qtest.
    : "${PR_BASE_SHA:?PR_BASE_SHA is required}"
    case "$PR_BASE_SHA" in
      ????????????????????????????????????????)
        case "$PR_BASE_SHA" in *[!0-9a-f]*) exit 2 ;; esac ;;
      *) echo "missing pull request base commit" >&2; exit 2 ;;
    esac
    head=$(git rev-parse HEAD)
    git fetch --no-tags --depth=1 origin "$PR_BASE_SHA"
    git cat-file -e "$PR_BASE_SHA^{commit}"
    for depth in 64 256 1024; do
      if fork=$(git merge-base "$PR_BASE_SHA" "$head" 2>/dev/null); then
        echo "merge base: $fork"
        exit 0
      fi
      git fetch --no-tags --deepen="$depth" origin "$PR_BASE_SHA" "$head" || break
    done
    if [ "$(git rev-parse --is-shallow-repository)" = true ]; then
      git fetch --no-tags --unshallow origin "$PR_BASE_SHA" "$head" || true
    fi
    if fork=$(git merge-base "$PR_BASE_SHA" "$head" 2>/dev/null); then
      echo "merge base: $fork"
    else
      # Not an error here: smoke finds no merge base either and selects
      # every qtest.
      echo "no merge base between $PR_BASE_SHA and $head; smoke will select every qtest"
    fi
    ;;
  volume)
    : "${GITHUB_ENV:?GITHUB_ENV is required}"
    reap_orphans
    volume=$(docker inspect "$(hostname)" \
      --format '{{range .Mounts}}{{if eq .Destination "'"$PWD"'"}}{{.Name}}{{end}}{{end}}')
    if [ -z "$volume" ]; then
      echo "The guest's daemon does not back this workspace with a named volume."
      echo "Mounts it does know:"
      docker inspect "$(hostname)" \
        --format '{{range .Mounts}}  {{.Destination}} = {{.Source}}{{"\n"}}{{end}}'
      exit 1
    fi
    echo "WORKSPACE_VOLUME=$volume" >> "$GITHUB_ENV"
    echo "workspace volume: $volume"
    ;;
  run|run-tests)
    # run-tests also gives the container the TAP device and the capability
    # to create one, which the BCM570x and Xframe vnet cases need. The
    # container's own network namespace confines what it can change.
    tap_options=()
    if [ "$1" = run-tests ]; then
      tap_options=(--device /dev/net/tun --cap-add NET_ADMIN)
    fi
    shift
    : "${IMAGE_ID:?IMAGE_ID is required}"
    parent=$(docker inspect "$(hostname)" --format '{{.Id}}')
    started=$(docker inspect "$parent" --format '{{.Created}}')
    # Leave five minutes for job cleanup before its 175-minute deadline.
    remaining=$(( $(date -d "$started" +%s) + 170 * 60 - $(date +%s) ))
    if [ "$remaining" -le 0 ]; then
      echo 'The job has exhausted its child-container deadline.' >&2
      exit 124
    fi
    options=()
    while [ "$#" -gt 0 ] && [ "$1" != "$IMAGE_ID" ]; do
      options+=("$1")
      shift
    done
    [ "$#" -gt 1 ] || { echo 'run requires IMAGE_ID and a command' >&2; exit 2; }
    shift
    child="qemu-ci-${parent:0:12}-$$"
    cleanup() {
      if docker inspect "$child" >/dev/null 2>&1; then
        docker rm -f "$child"
      fi
    }
    trap cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # The daemon owns this sibling. Its deadline must survive losing this shell.
    # Bash runs a trap only once a foreground command returns, so wait on a
    # background client: a signal then interrupts the wait and removes the
    # child at once.
    docker run --rm --name "$child" --label "ci.parent=$parent" \
      --ulimit core=0:0 --entrypoint /usr/bin/timeout "${tap_options[@]}" \
      "${options[@]}" \
      "$IMAGE_ID" --signal=TERM --kill-after=30s "${remaining}s" "$@" &
    wait "$!"
    ;;
  check)
    : "${WORKSPACE_VOLUME:?WORKSPACE_VOLUME is required}"
    : "${IMAGE_ID:?IMAGE_ID is required}"
    if ! bash "$0" run -v "$WORKSPACE_VOLUME:/src" "$IMAGE_ID" \
         test -f /src/meson.build; then
      echo "The guest's Docker daemon cannot see this job's checkout."
      exit 1
    fi
    # check tap: the test steps run in run-tests mode, which needs the
    # host's TAP device. Without it every test step on this builder would
    # fail with only Docker's device error, so say so before the build.
    if [ "${2-}" = tap ] &&
       ! bash "$0" run-tests "$IMAGE_ID" test -c /dev/net/tun; then
      builder=$(docker info --format '{{.Name}}' 2>/dev/null || echo unknown)
      echo "The Docker host on builder $builder cannot give a test container"
      echo "/dev/net/tun with CAP_NET_ADMIN, which the BCM570x and Xframe TAP"
      echo "cases need. Load the tun module or create /dev/net/tun there."
      exit 1
    fi
    ;;
  *)
    echo 'usage: runner-setup docker|describe|fetch-base|image|volume|assets|check [tap]|report-failure|nudge-queue' >&2
    echo '       runner-setup run|run-tests [Docker options] IMAGE_ID command' >&2
    exit 2
    ;;
esac
