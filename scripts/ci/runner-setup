#!/bin/bash
# The Forgejo jobs share a Docker daemon. Pass its workspace volume to
# sibling containers instead of a path inside the job container.
set -eu

# Remove child containers whose job container has gone. A job killed
# outright never runs its own cleanup, and its child would otherwise hold
# the daemon until the child's deadline. List the children before the
# running containers: a child exists only once its parent was running, so
# a parent still running is certain to be in the later list.
reap_orphans() {
  local children running id parent

  if ! children=$(docker ps -a --filter label=ci.parent \
                  --format '{{.ID}} {{.Label "ci.parent"}}') ||
     ! running=$(docker ps --no-trunc --filter status=running \
                 --format '{{.ID}}'); then
    echo 'Could not list containers; leaving child containers alone.' >&2
    return 0
  fi
  while read -r id parent; do
    [ -n "$id" ] || continue
    if [ -n "$parent" ] && printf '%s\n' "$running" | grep -qxF "$parent"; then
      continue
    fi
    echo "removing child container $id of finished job ${parent:-unknown}"
    docker rm -f "$id" >/dev/null || true
  done <<< "$children"
}

case "${1-}" in
  volume)
    : "${GITHUB_ENV:?GITHUB_ENV is required}"
    reap_orphans
    volume=$(docker inspect "$(hostname)" \
      --format '{{range .Mounts}}{{if eq .Destination "'"$PWD"'"}}{{.Name}}{{end}}{{end}}')
    if [ -z "$volume" ]; then
      echo "The guest's daemon does not back this workspace with a named volume."
      echo "Mounts it does know:"
      docker inspect "$(hostname)" \
        --format '{{range .Mounts}}  {{.Destination}} = {{.Source}}{{"\n"}}{{end}}'
      exit 1
    fi
    echo "WORKSPACE_VOLUME=$volume" >> "$GITHUB_ENV"
    echo "workspace volume: $volume"
    ;;
  run)
    shift
    : "${IMAGE_ID:?IMAGE_ID is required}"
    parent=$(docker inspect "$(hostname)" --format '{{.Id}}')
    started=$(docker inspect "$parent" --format '{{.Created}}')
    # Leave five minutes for job cleanup before its 175-minute deadline.
    remaining=$(( $(date -d "$started" +%s) + 170 * 60 - $(date +%s) ))
    if [ "$remaining" -le 0 ]; then
      echo 'The job has exhausted its child-container deadline.' >&2
      exit 124
    fi
    options=()
    while [ "$#" -gt 0 ] && [ "$1" != "$IMAGE_ID" ]; do
      options+=("$1")
      shift
    done
    [ "$#" -gt 1 ] || { echo 'run requires IMAGE_ID and a command' >&2; exit 2; }
    shift
    child="qemu-ci-${parent:0:12}-$$"
    cleanup() {
      if docker inspect "$child" >/dev/null 2>&1; then
        docker rm -f "$child"
      fi
    }
    trap cleanup EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # The daemon owns this sibling. Its deadline must survive losing this shell.
    # Bash runs a trap only once a foreground command returns, so wait on a
    # background client: a signal then interrupts the wait and removes the
    # child at once.
    docker run --rm --name "$child" --label "ci.parent=$parent" \
      --ulimit core=0:0 --entrypoint /usr/bin/timeout "${options[@]}" \
      "$IMAGE_ID" --signal=TERM --kill-after=30s "${remaining}s" "$@" &
    wait "$!"
    ;;
  check)
    : "${WORKSPACE_VOLUME:?WORKSPACE_VOLUME is required}"
    : "${IMAGE_ID:?IMAGE_ID is required}"
    if ! bash "$0" run -v "$WORKSPACE_VOLUME:/src" "$IMAGE_ID" \
         test -f /src/meson.build; then
      echo "The guest's Docker daemon cannot see this job's checkout."
      exit 1
    fi
    ;;
  *)
    echo 'usage: runner-setup volume|check|run [Docker options] IMAGE_ID command' >&2
    exit 2
    ;;
esac
