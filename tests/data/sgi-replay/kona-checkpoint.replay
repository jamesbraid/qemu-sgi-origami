# Synthetic same-build model checkpoint test, not a guest or hardware capture.
sgi-replay 2
head sgi-kona
write 4 0x00007c 0x11223344
read 4 0x00007c 0x11223344
write 4 0xc10000 1
write 4 0xc10000 0x3
write 4 0xc10000 1
write 4 0xc10000 0x3fc
write 4 0xc10000 0
write 4 0xc10000 0
write 4 0xc10000 1
write 4 0xc10000 0x2
write 4 0xc10000 1
write 4 0xc10000 1
write 4 0xc10000 0x6
write 4 0xc10000 100
write 4 0xc10000 50
pixel 100 50 0x00ff0000
display-pixel 100 50 0x00ff0000
write 4 0xc10000 1
write 4 0xc10000 0x3
write 4 0xc10000 2
write 4 0xc10000 0
write 4 0xc10000 0x3fc
write 4 0xc10000 0
write 4 0xc10000 1
write 4 0xc10000 0x2
write 4 0xc10000 2
# Save the green point packet after its selector and first coordinate.
write 4 0xc10000 1
write 4 0xc10000 0x6
write 4 0xc10000 200
# checkpoint
read 4 0x00007c 0x11223344
pixel 100 50 0x00ff0000
display-pixel 100 50 0x00ff0000
pixel 200 150 0
write 4 0xc10000 150
pixel 200 150 0x0000ff00
display-pixel 200 150 0x0000ff00
pixel 100 50 0x00ff0000
write 4 0x00007c 0x55667788
read 4 0x00007c 0x55667788
