# SPDX-License-Identifier: GPL-2.0-or-later
#
# The IO6 PROM drawing its graphical System Maintenance Menu on an
# InfiniteReality pipe: every register access of one emulated PROM boot
# to the pipe's window, in order, 40,617 writes and 9,106 reads. Each
# read asserts the value the run returned, 7,233 of them credit-register
# reads the PROM polls to exactly zero before each command. The
# screendump at the end is the model's frame after the stream, which
# QEMU 4284de64a1 and the change adding this fixture both produce byte
# for byte. It has 172 distinct colours, as a screendump recorded from a
# second emulated boot does. It is a check against the model, not a
# capture of a real pipe's display.
sgi-replay 2
head sgi-kona
read 4 0x4 0xc102555
read 4 0x24 0x0
write 4 0x24 0x3000
read 4 0x4 0xc102555
read 4 0x4 0xc102555
read 4 0x4 0xc102555
read 4 0x24 0x3000
write 4 0x24 0x300b
read 4 0x64 0x0
read 4 0x24 0x300b
