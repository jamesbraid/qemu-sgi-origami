# CMAP, XMAP and WID the way the stock IRIX 6.5.30 X server programs them,
# reduced from the desktop session of trace irix-20260922T133830-79813f:
#  - a CMAP selector carries the map in bits 4:0 and the first entry in
#    bits 15:8, and the data port advances one entry per write
#  - the two masks are a pair, COLORMASKLSBSA over the colour and
#    COLORMASKMSBS over the WID: a rectangle fill with a nonzero
#    COLORMASKMSBS writes DRBPOINTERS bits 23:16 into the WID plane,
#    whether or not it also writes colour, and nothing else touches it
#  - scanout resolves every pixel through
#    cmap[(xmap_mode[wid] >> 5 & 0x1f) * 256 + (native & 0xff)], with entry
#    bits 31:24, 23:16 and 15:8 as red, green and blue
#  - a rectangle fill with FILLMODE bit 20 or 22 set takes BKGRD_RG; the
#    guest always sets one of them and leaves PACKEDCOLOR zero

# --- palette: map 17 entries 0,1 then 16,17 through the start-entry selector ---
write 2 0x070c30 0x0011
write 4 0x070d18 0x00000000
write 4 0x070d18 0xff000000
write 2 0x070c30 0x1011
write 4 0x070d18 0xc1c1c100
write 4 0x070d18 0x80808000

# --- XMAP: entry 1 = 0x621 (map 17), entry 9 = 0x7a4 (map 29), as the guest writes them ---
write 1 0x071c88 0x04
write 4 0x071e00 0x00000621
write 1 0x071c88 0x24
write 4 0x071e00 0x000007a4

# --- FIFO/context preamble, copied from fill.replay ---
write 1 0x073c08 0x55
read 1 0x073c08 0x55
write 4 0x072038 0x06246800
write 1 0x072008 0x06
read 2 0x0720b0 0x2468
read 4 0x008000 0x0
write 4 0x011000 0x0
write 4 0x130500 0x000004fc
read 4 0x011020 0x00080000
write 4 0x011028 0x00080000
read 4 0x011020 0x0
write 4 0x120400 0
write 4 0x120400 1
write 4 0x120400 2
write 4 0x120400 3
write 4 0x120400 4
