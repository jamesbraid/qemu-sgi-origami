write 4 0x120400 54
write 4 0x120400 55
write 4 0x120400 56
write 4 0x120400 57
write 4 0x120400 58
write 4 0x120400 59
write 4 0x120400 60
write 4 0x120400 61
write 4 0x120400 62
read 4 0x011020 0x10000000
write 4 0x011028 0x10000000
write 8 0x130400 0x123456789abcdef0
read 8 0x130400 0x123456789abcdef0
write 4 0x120400 0x0000f400
read 4 0x120400 0x0000f400

# --- display enable ---
write 4 0x072038 0x1e000400

# --- WID plane: (0,0)-(63,63) gets WID 1 (zero colour mask, MSBS 0xf0, DRBPOINTERS 0x0101c0) ---
write 8 0x120400 0x0019630400000000
write 8 0x120400 0x00196204000000f0
write 8 0x120400 0x00196404ffffffff
write 8 0x120400 0x00196d04000101c0
write 8 0x120400 0x001961040013f500
write 8 0x120400 0x0019100400100000
write 8 0x120400 0x0019400400000011
write 8 0x120400 0x0018460400000000
write 8 0x120400 0x001c4704003f003f
wid 10 10 1
pixels 8 8 8 8 0x0

# --- BLOCKXYENDI fill of the Toolchest kind: PACKEDCOLOR 0, BKGRD_RG 0x10, mask 0xff, DRBPOINTERS 0x090240 ---
write 8 0x120400 0x00196304000000ff
write 8 0x120400 0x0019620400000000
write 8 0x120400 0x00196404000000ff
write 8 0x120400 0x00196d0400090240
write 8 0x120400 0x001961040c004504
write 8 0x120400 0x0019100400100000
write 8 0x120400 0x00185b0400000000
write 8 0x120400 0x0019400400000010
write 8 0x120400 0x0019410400000ff0
write 8 0x120400 0x0018460400080008
write 8 0x120400 0x001c4704000f000f
pixels 8 8 8 8 0x10
wid 10 10 1
display-pixel 10 10 0x00c1c1c1

# --- IR_ALIAS fill of the backdrop kind: index 17 ---
write 8 0x120400 0x0019100411400000
write 8 0x120400 0x0019400400000011
write 8 0x120400 0x0018460400100008
write 8 0x120400 0x001847040017000f
write 8 0x120400 0x001c450400000018
pixels 16 8 8 8 0x11
wid 20 10 1
display-pixel 20 10 0x00808080

# --- IR_ALIAS fill of index 1: the IRIS red entry must display red ---
write 8 0x120400 0x0019400400000001
write 8 0x120400 0x0018460400180008
write 8 0x120400 0x00184704001f000f
write 8 0x120400 0x001c450400000018
pixels 24 8 8 8 0x1
display-pixel 28 10 0x00ff0000

# --- glyph row: set bits ink PACKEDCOLOR 0, clear bits BKGRD_RG 0x10, both through WID 1 ---
write 8 0x120400 0x0019100410400008
write 8 0x120400 0x0019400400000010
write 8 0x120400 0x0018460400200008
write 8 0x120400 0x0018470400270008
write 8 0x120400 0x001c7004f0000000
pixel 32 8 0x0
pixel 36 8 0x10
wid 32 8 1
wid 36 8 1
display-pixel 32 8 0x0
display-pixel 36 8 0x00c1c1c1

# --- a paint outside the WID-1 region resolves through entry 0 (reset 0x7a4 -> map 29, zero here) ---
write 8 0x120400 0x0019100411400000
write 8 0x120400 0x0019400400000010
write 8 0x120400 0x0018460400640064
write 8 0x120400 0x0018470400670067
write 8 0x120400 0x001c450400000018
pixels 100 100 4 4 0x10
wid 100 100 0
display-pixel 100 100 0x0
