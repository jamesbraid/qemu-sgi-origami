# CMAP entries pack the 24-bit colour left-justified (0xRRGGBB00); the low
# byte's meaning is unknown. Every one of 24,708 live CMAP writes has a
# zero low byte; 0xffffff00 is the white the census recovered at bank 17
# index 7. Loads bank 17 index 17 with that same white value and reuses
# the fill.replay FIFO preamble to paint through it.

# --- palette setup: map 17 entry 17 = white, XMAP entry 5 -> map 17 ---
write 2 0x070c30 0x0011
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0x0
write 4 0x070d18 0xffffff00
write 1 0x071c88 0x14
write 4 0x071e00 0x00000621

# --- FIFO/context preamble, copied from fill.replay ---
write 1 0x073c08 0x55
read 1 0x073c08 0x55
write 4 0x072038 0x06246800
write 1 0x072008 0x06
read 2 0x0720b0 0x2468
read 4 0x008000 0x0
write 4 0x011000 0x0
write 4 0x130500 0x000004fc
read 4 0x011020 0x00080000
write 4 0x011028 0x00080000
read 4 0x011020 0x0
write 4 0x120400 0
write 4 0x120400 1
write 4 0x120400 2
write 4 0x120400 3
write 4 0x120400 4
write 4 0x120400 5
write 4 0x120400 6
write 4 0x120400 7
write 4 0x120400 8
write 4 0x120400 9
write 4 0x120400 10
write 4 0x120400 11
write 4 0x120400 12
write 4 0x120400 13
write 4 0x120400 14
write 4 0x120400 15
write 4 0x120400 16
write 4 0x120400 17
write 4 0x120400 18
write 4 0x120400 19
write 4 0x120400 20
write 4 0x120400 21
write 4 0x120400 22
write 4 0x120400 23
write 4 0x120400 24
write 4 0x120400 25
write 4 0x120400 26
write 4 0x120400 27
write 4 0x120400 28
