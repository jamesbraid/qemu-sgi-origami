write 4 0x120400 61
write 4 0x120400 62
read 4 0x011020 0x10000000
write 4 0x011028 0x10000000
write 8 0x130400 0x123456789abcdef0
read 8 0x130400 0x123456789abcdef0
write 4 0x120400 0x0000f400
read 4 0x120400 0x0000f400
# --- tag the target rectangle WID 5 with a zero-colour-mask plane fill ---
write 8 0x120400 0x0019630400000000
write 8 0x120400 0x00196204000000f0
write 8 0x120400 0x00196d0400050000
write 8 0x120400 0x00184604000a000a
write 8 0x120400 0x001c4704000d000d
write 8 0x120400 0x0019620400000000

write 8 0x120400 0x0019630400ffffff
write 8 0x120400 0x001961040c000000
write 8 0x120400 0x0019400400000011
write 8 0x120400 0x00184604000a000a
write 8 0x120400 0x00184704000d000d
write 8 0x120400 0x00196d0400050000
write 8 0x120400 0x001c450400000018

# --- sanity check: fill mechanics unchanged from fill.replay ---
pixels 10 10 4 4 0x11
wid 10 10 5

# --- display-enable, mirroring fill.replay's own late placement ---
write 4 0x072038 0x1e000400

# --- discriminating check: fails on unmodified si_cmap_rgb ---
display-pixel 10 10 0x00ffffff
