sgi-replay 2
head sgi-mgras
# Synthetic fill through the MGRAS command FIFO. Scanout resolves every
# pixel through the colour map its WID's XMAP mode selects, so the fill is
# painted where the VC3 main display-ID table names WID 5 and a palette
# entry is loaded.
write 1 0x073c08 0x55
read 1 0x073c08 0x55
write 4 0x072038 0x06246800
write 1 0x072008 0x06
read 2 0x0720b0 0x2468
read 4 0x008000 0x0
write 4 0x011000 0x0
write 4 0x130500 0x000004fc
read 4 0x011020 0x00080000
write 4 0x011028 0x00080000
read 4 0x011020 0x0
write 4 0x120400 0
write 4 0x120400 1
write 4 0x120400 2
write 4 0x120400 3
write 4 0x120400 4
write 4 0x120400 5
write 4 0x120400 6
write 4 0x120400 7
write 4 0x120400 8
write 4 0x120400 9
write 4 0x120400 10
write 4 0x120400 11
write 4 0x120400 12
write 4 0x120400 13
write 4 0x120400 14
write 4 0x120400 15
write 4 0x120400 16
write 4 0x120400 17
write 4 0x120400 18
write 4 0x120400 19
write 4 0x120400 20
write 4 0x120400 21
write 4 0x120400 22
write 4 0x120400 23
write 4 0x120400 24
write 4 0x120400 25
write 4 0x120400 26
write 4 0x120400 27
write 4 0x120400 28
write 4 0x120400 29
write 4 0x120400 30
write 4 0x120400 31
write 4 0x120400 32
write 4 0x120400 33
write 4 0x120400 34
write 4 0x120400 35
write 4 0x120400 36
write 4 0x120400 37
write 4 0x120400 38
write 4 0x120400 39
write 4 0x120400 40
write 4 0x120400 41
write 4 0x120400 42
write 4 0x120400 43
write 4 0x120400 44
write 4 0x120400 45
write 4 0x120400 46
write 4 0x120400 47
write 4 0x120400 48
write 4 0x120400 49
write 4 0x120400 50
write 4 0x120400 51
write 4 0x120400 52
write 4 0x120400 53
write 4 0x120400 54
write 4 0x120400 55
write 4 0x120400 56
write 4 0x120400 57
write 4 0x120400 58
write 4 0x120400 59
write 4 0x120400 60
write 4 0x120400 61
write 4 0x120400 62
read 4 0x011020 0x10000000
write 4 0x011028 0x10000000
write 8 0x130400 0x123456789abcdef0
read 8 0x130400 0x123456789abcdef0
write 4 0x120400 0x0000f400
read 4 0x120400 0x0000f400

# --- map 5 entry 0x33, and XMAP entry 5 selecting map 5 ---
write 2 0x070c30 0x3305
write 4 0x070d18 0x11223300
write 1 0x071c88 0x14
write 4 0x071e00 0x000000a0

# --- VC3 main display-ID table (register 4): WID 5 over (10,10)-(13,13) ---
write 4 0x072038 0x04050000
write 4 0x072038 0x07200000
write 2 0x072190 0x0000
write 2 0x072190 0x0145
write 2 0x072190 0x01c0
write 2 0x072190 0xffe0
write 4 0x072038 0x07050a00
write 2 0x072190 0x2000
write 2 0x072190 0x2000
write 2 0x072190 0x2000
write 2 0x072190 0x2000
wid 10 10 5
wid 14 10 0
wid 10 14 0

# --- a fill with a zero colour mask and COLORMASKMSBS set writes no WID ---
write 8 0x120400 0x0019630400000000
write 8 0x120400 0x00196204000000f0
write 8 0x120400 0x00196d0400090000
write 8 0x120400 0x0019100400100000
write 8 0x120400 0x00184604000a000a
write 8 0x120400 0x001c4704000d000d
wid 10 10 5
pixels 10 10 4 4 0x0
write 8 0x120400 0x0019620400000000

# --- CI8 fills: colour comes from FILLCOLOR_R and a BLOCKXYENDI execute
# triggers the fill; a direct-command IR_ALIAS execute paints nothing ---
write 8 0x120400 0x0019630400ffffff
write 8 0x120400 0x001961040c000000
write 8 0x120400 0x0019760400000011
write 8 0x120400 0x00184604000a000a
write 8 0x120400 0x00196d0400090000
write 8 0x120400 0x001c4704000d000d
pixels 10 10 4 4 0x11
wid 10 10 5
write 8 0x120400 0x0019760400000022
write 8 0x120400 0x001c4704000d000d
pixels 10 10 4 4 0x22
wid 10 10 5

# --- RGB fill: PP1FILLMODE's format bit selects FILLCOLOR_R/G/B as a
# packed 24-bit colour instead of a bare CI8 index ---
write 8 0x120400 0x001961040c002000
write 8 0x120400 0x0019760400000110
write 8 0x120400 0x0019770400000220
write 8 0x120400 0x0019780400000330
write 8 0x120400 0x00184604000a000a
write 8 0x120400 0x001c4704000d000d
pixel 11 11 0x00112233
pixel 20 11 0x0
display-pixel 11 11 0x0
write 4 0x072038 0x1e000400
display-pixel 11 11 0x00112233
read 4 0x020008 0x0
