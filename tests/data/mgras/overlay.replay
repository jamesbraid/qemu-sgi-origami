# --- menu-body fill: overlay index 1 over (8,8)-(15,15), main planes untouched ---
write 8 0x120400 0x001961040c13f504
write 8 0x120400 0x00196304fbfdfeff
write 8 0x120400 0x00196404fbfdfeff
write 8 0x120400 0x0019630400000000
