write 8 0x120400 0x0019100400100000
write 8 0x120400 0x0018460400280028
write 8 0x120400 0x001c4704002f0028
overlay 44 40 1
write 8 0x120400 0x0019100410400008
write 8 0x120400 0x00185b0400000000
write 8 0x120400 0x00185c0400002000
write 8 0x120400 0x0018460400280028
write 8 0x120400 0x001c4704002f0028
write 8 0x120400 0x001c7004f0000000
