overlay 15 15 1
overlay 16 16 0
pixels 8 8 8 8 0x10
display-pixel 10 10 0x00204060
display-pixel 20 20 0x00c1c1c1
# checkpoint

# --- after a restore the overlay, its mode and its composition survive ---
overlay 10 10 1
read 4 0x071e80 0x000000c9
display-pixel 10 10 0x00204060

# --- overlay disabled for WID 1: the main planes show; re-enabled: the overlay ---
write 4 0x071e80 0x00000000
display-pixel 10 10 0x00c1c1c1
write 4 0x071e80 0x000000c9
display-pixel 10 10 0x00204060

# --- unpost: a fill of index 0 over the same rectangle restores the view ---
write 8 0x120400 0x0019760400000000
write 8 0x120400 0x0018460400080008
write 8 0x120400 0x001c4704000f000f
overlay 10 10 0
pixels 8 8 8 8 0x10
display-pixel 10 10 0x00c1c1c1

# --- XOR outline: RE_LINE (30,20)-(40,20), RED index 1, drawn twice ---
