write 8 0x120400 0x001961041813f504
write 8 0x120400 0x00185b0400000000
write 8 0x120400 0x00185c0400001000
write 8 0x120400 0x00184004001e0014
write 8 0x120400 0x001c410400280014
overlay 30 20 1
overlay 40 20 1
overlay 41 20 0
pixel 35 20 0x10
display-pixel 35 20 0x00204060
write 8 0x120400 0x00184004001e0014
write 8 0x120400 0x001c410400280014
overlay 35 20 0
pixel 35 20 0x10
display-pixel 35 20 0x00c1c1c1

# --- menu text: a glyph row inks index 2 on set bits and leaves clear bits alone ---
