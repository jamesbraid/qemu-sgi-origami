sgi-replay 2
head sgi-mgras
# Overlay planes the way the stock IRIX 6.5.30 X server drives them for a
# window on its overlay visual (popup and Toolchest menus, XOR outlines),
# reduced from desktop traces irix-20260926T035440-7d2dc3 and
# irix-20260926T052228-910b39:
#  - a primitive draws into the overlay when DRBPOINTERS is 0x101c0 and
#    COLORMASKMSBS enables bits 6:4; the server also zeroes COLORMASKLSBSA,
#    so the main planes keep their pixels
#  - a solid fill (FILLMODE bit 20) takes register 0x176's index; glyph
#    and line ink take RED >> 12; a glyph row's clear bits paint nothing
#  - an overlay pixel's WID comes from the VC3 overlay display-ID table
#    (register 5), a main pixel's from the main table (register 4); no
#    drawing writes a WID
#  - XMAP 0x071e80 holds one overlay mode per WID; bit 0 enables it and
#    bits 7:3 pick the map, so WID 1's 0xc9 resolves through map 25
#  - overlay index 0 is transparent: the main planes show through
# The "# checkpoint" line marks where sgi-mgras/overlay-migration saves and
# restores the machine.

# --- palette: map 17 entries 16,17; map 25 (the overlay's) entries 1,2 ---
write 2 0x070c30 0x1011
write 4 0x070d18 0xc1c1c100
write 4 0x070d18 0x80808000
write 2 0x070c30 0x0119
write 4 0x070d18 0x20406000
write 4 0x070d18 0x80a0c000

# --- XMAP: WID 1 main 0x621 (map 17), overlay 0xc9 (map 25); one entry per WID ---
write 1 0x071c88 0x04
write 4 0x071e00 0x00000621
write 4 0x071e80 0x000000c9
read 4 0x071e80 0x000000c9
write 1 0x071c88 0x08
read 4 0x071e80 0x00000000
write 1 0x071c88 0x04
read 4 0x071e80 0x000000c9

