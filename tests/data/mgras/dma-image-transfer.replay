sgi-replay 2
head sgi-mgras
# A host-to-screen DMA draw of a two-pixel row, translated from
# sn0-origin2000-mgras-test.c's test_dma_image_transfer_paints_from_host_memory
# register sequence (widget 9, one page-list entry, an 8-byte source row).
# The two 'dma' lines below are exactly the sgi_mgras_dma_chunk trace events
# that same sequence produces under
# test_dma_image_transfer_traces_source_chunks: the page-list entry the
# transfer fetches, and the row's eight source bytes, which lie inside one
# guest page and so arrive as one chunk. Both addresses are the plain node
# address (node 0, so bare byte offsets 0x2018 and 0x7000) the model resolves
# before sgi_mgras_xio_compose() shifts widget 9 into the high bits -- not
# that composed fabric address, which only routes the read through
# s->fabric_as and is not otherwise backed by memory a replay's
# qtest_memwrite can reach.
#
# The command-channel handshake below (read/write 0x008000 through the 63
# 0x120400 context words) is copied verbatim from tests/data/mgras/fill.replay:
# REG_CONTEXT_COMMAND ignores paint commands until a context has been entered,
# and a synthetic fixture built straight from a qtest register sequence (as
# opposed to a real capture, which already contains the guest's own context
# entry somewhere earlier in the session) has to supply it explicitly.
dma 0x2018 8 0000000000000007
dma 0x7000 8 0011223300445566
read 4 0x008000 0x0
write 4 0x011000 0x0
write 4 0x130500 0x000004fc
read 4 0x011020 0x00080000
write 4 0x011028 0x00080000
read 4 0x011020 0x0
