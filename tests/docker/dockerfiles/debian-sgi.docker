# SPDX-License-Identifier: BSD-3-Clause
# Minimal public build environment for the maintained SGI machine tests.
# rust/sgi-gpu needs rustc 1.94 and trixie ships 1.85, so the toolchain comes
# from rustup, checked against the SHA-256 of the rustup-init 1.29.2 release
# (x86-64 only). The version is the one the Origami build image carries.
# cargo-about 0.9.3, a static binary checked against its release's SHA-256,
# checks the Rust crates' licences (scripts/ci/sgi-rust-licences.py).
FROM docker.io/library/debian:trixie-slim AS rust-toolchain
RUN apt-get update && \
    apt-get install --no-install-recommends -y ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
RUN test "$(dpkg --print-architecture)" = amd64 && \
    curl -fsSL -o /tmp/rustup-init \
        https://static.rust-lang.org/rustup/archive/1.29.2/x86_64-unknown-linux-gnu/rustup-init && \
    echo "5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4  /tmp/rustup-init" \
        | sha256sum -c - && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y --no-modify-path --profile minimal \
        --default-toolchain 1.99.1 --component rustfmt && \
    curl -fsSL -o /tmp/cargo-about.tgz \
        https://github.com/EmbarkStudios/cargo-about/releases/download/0.9.3/cargo-about-0.9.3-x86_64-unknown-linux-musl.tar.gz && \
    echo "3ad1e94ea1e63d69d1961f4fb15ccbbe9575d906111f96d2cb4dce6df48f71b4  /tmp/cargo-about.tgz" \
        | sha256sum -c - && \
    tar -xzf /tmp/cargo-about.tgz -C /usr/local/cargo/bin --strip-components=1 \
        cargo-about-0.9.3-x86_64-unknown-linux-musl/cargo-about && \
    chmod -R a+rX "$RUSTUP_HOME" "$CARGO_HOME"

FROM docker.io/library/debian:trixie-slim

# python3-jsonschema and python3-yaml are pythondeps.toml's sgi-model group,
# installed here so the model suites run without fetching from PyPI.
# gdb-multiarch drives the functional tests' reverse-debugging cases.
# python3-sphinx and python3-sphinx-rtd-theme build the manual, which the
# script suites check with warnings treated as errors.
# bindgen and libclang-dev build the Rust devices (configure --enable-rust).
# libvulkan1 and mesa-vulkan-drivers (lavapipe) give the SGI GPU back end's
# qtest a software Vulkan adapter.
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        binutils-mips64-linux-gnuabi64 \
        bindgen \
        build-essential \
        ca-certificates \
        ccache \
        gcc-mips64-linux-gnuabi64 \
        gdb-multiarch \
        git \
        libclang-dev \
        libegl-dev \
        libegl-mesa0 \
        libegl1 \
        libepoxy-dev \
        libfdt-dev \
        libgbm-dev \
        libgbm1 \
        libgl-dev \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-dev \
        libpixman-1-dev \
        libslirp-dev \
        libvulkan1 \
        meson \
        makefs \
        mesa-vulkan-drivers \
        ninja-build \
        pkg-config \
        python3 \
        python3-jsonschema \
        python3-pip \
        python3-sphinx \
        python3-sphinx-rtd-theme \
        python3-venv \
        python3-wheel \
        python3-yaml \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
# The toolchain is read-only; cargo downloads crates into a CARGO_HOME of its own.
RUN install -d -m 1777 /var/tmp/cargo-home
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/var/tmp/cargo-home
ENV PATH="/usr/local/cargo/bin:${PATH}"

# Populate functional dependencies before tests run without network access.
RUN python3 -m venv --system-site-packages /opt/qemu-tests && \
    /opt/qemu-tests/bin/pip install --no-cache-dir \
        pygdbmi==0.11.0.0 pylint==3.0.0
ENV PATH="/opt/qemu-tests/bin:${PATH}"
