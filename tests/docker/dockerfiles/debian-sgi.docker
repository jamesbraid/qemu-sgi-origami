# SPDX-License-Identifier: BSD-3-Clause
# Minimal public build environment for the maintained SGI machine tests.
FROM docker.io/library/debian:trixie-slim

# python3-jsonschema and python3-yaml are pythondeps.toml's sgi-model group,
# installed here so the model suites run without fetching from PyPI.
# gdb-multiarch drives the functional tests' reverse-debugging cases.
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        binutils-mips64-linux-gnuabi64 \
        build-essential \
        ca-certificates \
        ccache \
        gcc-mips64-linux-gnuabi64 \
        gdb-multiarch \
        git \
        libegl-dev \
        libegl-mesa0 \
        libegl1 \
        libepoxy-dev \
        libfdt-dev \
        libgbm-dev \
        libgbm1 \
        libgl-dev \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-dev \
        libpixman-1-dev \
        libslirp-dev \
        meson \
        makefs \
        ninja-build \
        pkg-config \
        python3 \
        python3-jsonschema \
        python3-pip \
        python3-venv \
        python3-wheel \
        python3-yaml \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

# Populate functional dependencies before tests run without network access.
RUN python3 -m venv --system-site-packages /opt/qemu-tests && \
    /opt/qemu-tests/bin/pip install --no-cache-dir \
        pygdbmi==0.11.0.0 pylint==3.0.0
ENV PATH="/opt/qemu-tests/bin:${PATH}"
