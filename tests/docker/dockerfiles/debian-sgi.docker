# SPDX-License-Identifier: GPL-2.0-or-later
# Minimal public build environment for the maintained SGI machine tests.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        binutils-mips64-linux-gnuabi64 \
        build-essential \
        ca-certificates \
        gcc-mips64-linux-gnuabi64 \
        git \
        libfdt-dev \
        libglib2.0-dev \
        libpixman-1-dev \
        libslirp-dev \
        meson \
        ninja-build \
        pkg-config \
        python3 \
        python3-venv \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*
