#!/usr/bin/env python3
# group: rw quick
#
# Test the chd block driver: hard disk images in MAME's CHD container.
#
# The images are made at test time by chd-fixture, which compresses a raw
# file with MAME's own CHD code, so the tree holds no binary blobs.
#
# SPDX-License-Identifier: BSD-3-Clause

import glob
import hashlib
import json
import os
import random
import re
import shutil
import subprocess

import iotests
from iotests import qemu_img, qemu_io

# 8 cylinders of the 16-head, 63-sector geometry chd-fixture records, so the
# size is a whole number of 4 KiB hunks.
RAW_SIZE = 8 * 16 * 63 * 512
HUNK = 4096

CODECS = ['lzma', 'zlib', 'huff', 'flac', 'zstd', 'none',
          'lzma,zlib,huff,flac']

raw_img = os.path.join(iotests.test_dir, 'raw.img')
chd_img = os.path.join(iotests.test_dir, 'test.chd')
diff_img = chd_img + '.diff.chd'
expected_img = os.path.join(iotests.test_dir, 'expected.img')


def fixture_prog():
    env = os.environ.get('CHD_FIXTURE_PROG')
    if env:
        return env
    build = os.path.dirname(os.path.abspath(iotests.qemu_img_args[0]))
    found = glob.glob(os.path.join(build, 'subprojects', 'libchdman*',
                                   'chd-fixture'))
    return found[0] if found else None


def fixture(*args):
    return subprocess.run([fixture_prog(), *args], text=True, check=True,
                          stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT).stdout.strip()


def make_raw(path):
    """Hunks of every kind: zero, repeated bytes, text, noise."""
    rnd = random.Random(1234)
    words = [b'alpha ', b'bravo ', b'charlie ', b'delta ', b'echo ']
    data = bytearray()
    for n in range(RAW_SIZE // HUNK):
        kind = n % 5
        if kind == 0:
            hunk = bytes(HUNK)
        elif kind == 1:
            hunk = bytes([n & 0xff]) * HUNK
        elif kind == 2:
            hunk = bytearray()
            while len(hunk) < HUNK:
                hunk += rnd.choice(words)
            hunk = bytes(hunk[:HUNK])
        elif kind == 3:
            hunk = bytes(rnd.getrandbits(8) for _ in range(HUNK))
        else:
            hunk = bytes(rnd.choice(b'\x00\x01\x02\x03')
                         for _ in range(HUNK))
        data += hunk
    with open(path, 'wb') as f:
        f.write(data)


def remove(*paths):
    for p in paths:
        try:
            os.remove(p)
        except FileNotFoundError:
            pass


def hexdump(output):
    """The data lines of a read -v, without its timing line."""
    return [ln for ln in output.splitlines() if re.match('[0-9a-f]{8}:', ln)]


def corrupt_first_hunks(path):
    """Overwrite compressed bytes of the first hunks."""
    # the hunks follow the metadata, which follows the 124-byte v5 header
    with open(path, 'r+b') as f:
        header = f.read(124)
        meta = int.from_bytes(header[48:56], 'big')
        f.seek(meta + 4)
        meta_len = int.from_bytes(f.read(4), 'big') & 0xffffff
        f.seek(meta + 16 + meta_len + 16)
        f.write(b'\xa5' * 64)


def info():
    out = qemu_img('info', '--output=json', '-f', 'chd', chd_img).stdout
    return json.loads(out)


def compare(expected=raw_img):
    """Does the CHD read the same as the expected raw image?"""
    return qemu_img('compare', '-f', 'raw', '-F', 'chd', expected, chd_img,
                    check=False).returncode == 0


def digest(path):
    with open(path, 'rb') as f:
        return hashlib.sha256(f.read()).hexdigest()


def write(target_fmt, path, *cmds):
    """Run the same qemu-io write commands on a CHD and its raw twin."""
    args = []
    for cmd in cmds:
        args += ['-c', cmd]
    return qemu_io('-f', target_fmt, *args, path)


def write_overlay(path, *cmds):
    """Write to a CHD with overlay=on, which keeps the diff after exit."""
    args = []
    for cmd in cmds:
        args += ['-c', cmd]
    return qemu_io('--image-opts', *args,
                   f'driver=chd,overlay=on,file.filename={path}')


class ChdTestCase(iotests.QMPTestCase):
    def setUp(self):
        make_raw(raw_img)

    def tearDown(self):
        remove(raw_img, chd_img, diff_img, diff_img + '.folding',
               chd_img + '.synctmp.chd', expected_img)


class TestRead(ChdTestCase):
    def test_every_codec_reads_as_raw(self):
        for codecs in CODECS:
            with self.subTest(codecs=codecs):
                fixture('create', chd_img, raw_img, codecs)
                self.assertTrue(compare())
                self.assertEqual(info()['virtual-size'], RAW_SIZE)

    def test_unaligned_reads_across_hunks(self):
        fixture('create', chd_img, raw_img, 'lzma')
        for offset, length in [(1, 511), (HUNK - 7, 15), (3 * HUNK + 512,
                               5 * HUNK + 1024), (RAW_SIZE - 1024, 1024)]:
            cmd = f'read -v {offset} {length}'
            want = qemu_io('-f', 'raw', '-c', cmd, raw_img).stdout
            got = qemu_io('-r', '-f', 'chd', '-c', cmd, chd_img).stdout
            self.assertEqual(hexdump(want), hexdump(got))

    def test_hunk_is_reported_as_cluster_size(self):
        fixture('create', chd_img, raw_img, 'zlib', str(2 * HUNK))
        self.assertEqual(info()['cluster-size'], 2 * HUNK)
        self.assertTrue(compare())

    def test_corrupt_hunk_is_an_io_error(self):
        fixture('create', chd_img, raw_img, 'lzma')
        corrupt_first_hunks(chd_img)
        res = qemu_io('-r', '-f', 'chd', '-c', f'read 0 {RAW_SIZE}', chd_img,
                      check=False)
        self.assertIn('Input/output error', res.stdout)

    def test_damaged_header_is_an_error_not_a_crash(self):
        fixture('create', chd_img, raw_img, 'lzma')
        for offset, length in [(60, 4), (56, 4), (40, 8), (32, 8)]:
            with self.subTest(offset=offset):
                with open(chd_img, 'r+b') as f:
                    f.seek(offset)
                    saved = f.read(length)
                    f.seek(offset)
                    f.write(bytes(length) if offset in (56, 60)
                            else b'\xff' * length)
                res = qemu_img('info', '-f', 'chd', chd_img, check=False)
                self.assertEqual(res.returncode, 1)
                with open(chd_img, 'r+b') as f:
                    f.seek(offset)
                    f.write(saved)

    def test_not_a_hard_disk_is_refused(self):
        remove(chd_img)
        with open(chd_img, 'wb') as f:
            f.write(b'MComprHD' + bytes(4096))
        res = qemu_img('info', '-f', 'chd', chd_img, check=False)
        self.assertNotEqual(res.returncode, 0)


class TestWrite(ChdTestCase):
    # Writes over each kind of hunk, across hunk boundaries and unaligned,
    # ending in a write that appends nothing new.
    WRITES = ['write -P 0x5a 0 512', 'write -P 0xa5 1000 20000',
              f'write -P 0x33 {HUNK * 7 + 512} {HUNK * 3}',
              f'write -P 0x77 {RAW_SIZE - 512} 512']

    def expect(self, *cmds):
        shutil.copyfile(raw_img, expected_img)
        write('raw', expected_img, *cmds)

    def test_uncompressed_is_written_in_place(self):
        fixture('create', chd_img, raw_img, 'none')
        before = info()
        cmds = self.WRITES + [f'write -z {HUNK * 3} {HUNK}']
        write('chd', chd_img, *cmds)
        self.expect(*cmds)
        self.assertFalse(os.path.exists(diff_img))
        self.assertTrue(compare(expected_img))
        self.assertEqual(before['virtual-size'], info()['virtual-size'])

    def test_compressed_writes_go_to_a_diff(self):
        fixture('create', chd_img, raw_img, 'lzma,zlib,huff,flac')
        base = digest(chd_img)
        write_overlay(chd_img, *self.WRITES[:2])
        self.assertEqual(base, digest(chd_img))
        self.assertTrue(os.path.exists(diff_img))
        self.expect(*self.WRITES[:2])
        self.assertTrue(compare(expected_img))

        # a second session attaches the diff and adds to it
        write_overlay(chd_img, *self.WRITES[2:])
        self.assertEqual(base, digest(chd_img))
        self.expect(*self.WRITES)
        self.assertTrue(compare(expected_img))

    def test_read_only_open_sees_the_diff(self):
        fixture('create', chd_img, raw_img, 'zlib')
        write_overlay(chd_img, *self.WRITES)
        self.expect(*self.WRITES)
        res = qemu_img('compare', '-f', 'raw', '-F', 'chd', expected_img,
                       chd_img, check=False)
        self.assertEqual(res.returncode, 0)
        self.assertFalse(
            qemu_img('compare', '-f', 'raw', '-F', 'chd', raw_img, chd_img,
                     check=False).returncode == 0)

    def test_info_with_a_diff_present(self):
        # qemu-img info opens without I/O, which a data-only child inherits
        fixture('create', chd_img, raw_img, 'lzma')
        write_overlay(chd_img, 'write -P 7 0 4096')
        self.assertEqual(info()['virtual-size'], RAW_SIZE)

    def test_symlinked_image_keeps_its_diff_beside_the_target(self):
        real_dir = os.path.join(iotests.test_dir, 'chd-real')
        real = os.path.join(real_dir, 'real.chd')
        os.makedirs(real_dir, exist_ok=True)
        try:
            fixture('create', real, raw_img, 'lzma')
            os.symlink(real, chd_img)
            write_overlay(chd_img, 'write -P 7 0 4096')
            self.assertTrue(os.path.exists(real + '.diff.chd'))
            self.assertFalse(os.path.exists(diff_img))
        finally:
            shutil.rmtree(real_dir)

    def test_overlay_diffs_an_image_that_has_a_sha1(self):
        fixture('create', chd_img, raw_img, 'zstd')
        base = digest(chd_img)
        res = qemu_io('--image-opts', '-c', 'write -P 0x11 0 4096',
                      f'driver=chd,overlay=on,file.filename={chd_img}')
        self.assertEqual(res.returncode, 0)
        self.assertEqual(base, digest(chd_img))
        self.assertTrue(os.path.exists(diff_img))

    def test_diff_needs_a_sha1_to_name_its_parent(self):
        fixture('create', chd_img, raw_img, 'none')
        self.assertIn('sha1 none', fixture('info', chd_img))
        res = qemu_io('--image-opts', '-c', 'write 0 512',
                      f'driver=chd,overlay=on,file.filename={chd_img}',
                      check=False)
        self.assertNotEqual(res.returncode, 0)
        self.assertIn('SHA-1', res.stdout)
        self.assertFalse(os.path.exists(diff_img))

    def test_zeroes_written_over_data_stay_zero(self):
        fixture('create', chd_img, raw_img, 'lzma')
        # hunk 3 holds noise: zero all of it, then part of hunk 4 and a range
        # across two later hunks
        cmds = [f'write -z {3 * HUNK} {HUNK}',
                f'write -z {4 * HUNK + 100} 300',
                f'write -z {11 * HUNK - 200} 400']
        write('chd', chd_img, *cmds)
        self.expect(*cmds)
        self.assertTrue(compare(expected_img))

    def test_corrupt_hunk_is_an_io_error_in_a_diff_too(self):
        fixture('create', chd_img, raw_img, 'lzma')
        write_overlay(chd_img, 'write -P 0x42 0 512')
        corrupt_first_hunks(chd_img)
        res = qemu_io('-r', '-f', 'chd', '-c', f'read 0 {RAW_SIZE}', chd_img,
                      check=False)
        self.assertIn('Input/output error', res.stdout)


class TestFold(ChdTestCase):
    WRITES = ['write -P 0x5a 0 512', 'write -P 0xa5 1000 20000',
              f'write -z {3 * HUNK} {HUNK}',
              f'write -P 0x77 {RAW_SIZE - 512} 512']

    def expect(self, *cmds):
        shutil.copyfile(raw_img, expected_img)
        write('raw', expected_img, *cmds)

    def leftovers(self):
        return [p for p in (diff_img, diff_img + '.folding',
                            chd_img + '.synctmp.chd', diff_img + '.new')
                if os.path.exists(p)]

    def test_clean_exit_folds_the_diff_with_the_same_codecs(self):
        for codecs in ['lzma', 'zlib', 'huff', 'flac', 'zstd',
                       'lzma,zlib,huff,flac']:
            with self.subTest(codecs=codecs):
                fixture('create', chd_img, raw_img, codecs)
                before = fixture('info', chd_img).split(' sha1 ')[0]
                write('chd', chd_img, *self.WRITES)
                self.assertEqual(self.leftovers(), [])
                self.assertEqual(fixture('info', chd_img).split(' sha1 ')[0],
                                 before)
                self.expect(*self.WRITES)
                self.assertTrue(compare(expected_img))
                self.assertNotIn('sha1 none', fixture('info', chd_img))

    def test_overlay_keeps_the_diff(self):
        fixture('create', chd_img, raw_img, 'lzma')
        base = digest(chd_img)
        write_overlay(chd_img, 'write -P 0x11 0 4096')
        self.assertEqual(base, digest(chd_img))
        self.assertEqual(self.leftovers(), [diff_img])
        # another session adds to it, and still does not fold
        write_overlay(chd_img, 'write -P 0x22 4096 4096')
        self.assertEqual(base, digest(chd_img))
        self.expect('write -P 0x11 0 4096', 'write -P 0x22 4096 4096')
        self.assertTrue(compare(expected_img))

    def test_session_that_wrote_nothing_leaves_no_diff(self):
        fixture('create', chd_img, raw_img, 'lzma')
        base = digest(chd_img)
        qemu_io('-f', 'chd', '-c', 'read 0 4096', chd_img)
        self.assertEqual(base, digest(chd_img))
        self.assertEqual(self.leftovers(), [])

    def test_read_only_session_does_not_fold(self):
        fixture('create', chd_img, raw_img, 'lzma')
        write_overlay(chd_img, 'write -P 0x11 0 4096')
        base = digest(chd_img)
        qemu_io('-r', '-f', 'chd', '-c', 'read 0 4096', chd_img)
        self.assertEqual(base, digest(chd_img))
        self.assertEqual(self.leftovers(), [diff_img])

    def test_fold_that_died_after_the_rename(self):
        fixture('create', chd_img, raw_img, 'lzma')
        write_overlay(chd_img, 'write -P 0x11 0 4096')
        # the marker holds the SHA-1 of the image the fold put in place; if
        # the image already has it, the diff is already part of the image
        sha1 = fixture('info', chd_img).split(' sha1 ')[1]
        with open(diff_img + '.folding', 'wb') as f:
            f.write(bytes.fromhex(sha1))
        # a read-only open cannot finish the fold, but must not attach the
        # diff: it no longer names this image as its parent
        self.assertTrue(compare())
        self.assertEqual(info()['virtual-size'], RAW_SIZE)
        self.assertEqual(self.leftovers(), [diff_img, diff_img + '.folding'])
        qemu_io('-f', 'chd', '-c', 'read 0 512', chd_img)
        self.assertEqual(self.leftovers(), [])
        self.assertTrue(compare())      # the guest's write is not there

    def test_fold_that_died_before_the_rename(self):
        fixture('create', chd_img, raw_img, 'lzma')
        write_overlay(chd_img, 'write -P 0x11 0 4096')
        with open(diff_img + '.folding', 'wb') as f:
            f.write(bytes(20))
        # the diff is still good: it is attached, and the open folds it
        qemu_io('-f', 'chd', '-c', 'read 0 512', chd_img)
        self.assertEqual(self.leftovers(), [])
        self.expect('write -P 0x11 0 4096')
        self.assertTrue(compare(expected_img))

    def test_symlinked_image_is_folded_in_its_target(self):
        real_dir = os.path.join(iotests.test_dir, 'chd-real')
        real = os.path.join(real_dir, 'real.chd')
        os.makedirs(real_dir, exist_ok=True)
        try:
            fixture('create', real, raw_img, 'lzma')
            os.symlink(real, chd_img)
            write('chd', chd_img, 'write -P 7 0 4096')
            self.assertTrue(os.path.islink(chd_img))
            self.assertEqual(os.listdir(real_dir), ['real.chd'])
            self.expect('write -P 7 0 4096')
            self.assertTrue(compare(expected_img))
        finally:
            shutil.rmtree(real_dir)

    def test_one_image_closed_twice_is_folded_once(self):
        self.make('lzma')
        res = qemu_io('-f', 'chd', '-c', 'write -P 1 0 4096', '-c', 'close',
                      '-c', f'open -o driver=chd,file.filename={chd_img}',
                      '-c', 'write -P 2 4096 4096', '-c', 'close', chd_img)
        self.assertNotIn('could not', res.stdout)
        self.assertEqual(self.leftovers(), [])
        self.expect('write -P 1 0 4096', 'write -P 2 4096 4096')
        self.assertTrue(compare(expected_img))

    def test_overlay_session_cancels_an_earlier_sessions_fold(self):
        self.make('lzma')
        base = digest(chd_img)
        qemu_io('-f', 'chd', '-c', 'write -P 1 0 4096', '-c', 'close', '-c',
                f'open -o driver=chd,overlay=on,file.filename={chd_img}',
                '-c', 'write -P 2 4096 4096', '-c', 'close', chd_img)
        self.assertEqual(base, digest(chd_img))
        self.assertEqual(self.leftovers(), [diff_img])
        self.expect('write -P 1 0 4096', 'write -P 2 4096 4096')
        self.assertTrue(compare(expected_img))

    def make(self, codecs):
        fixture('create', chd_img, raw_img, codecs)


if __name__ == '__main__':
    if fixture_prog() is None or not os.access(fixture_prog(), os.X_OK):
        iotests.notrun('chd-fixture is not built (configure --enable-chd and '
                      'build the chd-fixture target)')
    iotests.main(supported_fmts=['raw'], supported_protocols=['file'],
                 required_fmts=['chd'])
