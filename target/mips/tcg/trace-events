# See docs/devel/tracing.rst for syntax documentation.

# translate.c
mips_translate_c0(const char *instr, const char *rn, int reg, int sel) "%s %s (reg %d sel %d)"
mips_translate_tr(const char *instr, int rt, int u, int sel, int h) "%s (reg %d u %d sel %d h %d)"

# op_helper.c
mips_transaction_failed(int cpu, uint64_t vaddr, uint64_t paddr, unsigned int size, int access, uint32_t response) "cpu %d vaddr 0x%" PRIx64 " paddr 0x%" PRIx64 " size %u access %d response 0x%x"

# system/tlb_helper.c
mips_exception(int cpu, uint32_t asid, int exccode, const char *name, uint64_t pc, uint64_t badvaddr, uint32_t status, uint32_t cause) "cpu %d asid 0x%x exccode %d name \"%s\" pc 0x%" PRIx64 " badvaddr 0x%" PRIx64 " status 0x%08x cause 0x%08x"
mips_ext_interrupt_entry(int64_t vtime, int cpu, uint64_t pc, uint32_t status, uint32_t cause) "vtime %" PRId64 " cpu %d pc 0x%" PRIx64 " status 0x%08x cause 0x%08x"
mips_syscall(int cpu, uint32_t asid, uint64_t pc, uint64_t v0, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3) "cpu %d asid 0x%x pc 0x%" PRIx64 " v0 0x%" PRIx64 " a0 0x%" PRIx64 " a1 0x%" PRIx64 " a2 0x%" PRIx64 " a3 0x%" PRIx64
mips_tlb_write(int cpu, int idx, uint64_t entryhi, uint64_t lo0, uint64_t lo1, uint32_t pagemask, uint64_t pc) "cpu %d idx %d entryhi 0x%" PRIx64 " lo0 0x%" PRIx64 " lo1 0x%" PRIx64 " pagemask 0x%x pc 0x%" PRIx64

# system/special_helper.c
mips_eret(int cpu, uint32_t asid, uint64_t pc, uint32_t status, uint64_t v0, uint64_t a3, bool user) "cpu %d asid 0x%x pc 0x%" PRIx64 " status 0x%08x v0 0x%" PRIx64 " a3 0x%" PRIx64 " user %d"
